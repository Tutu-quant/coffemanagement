@using System.Globalization
@model Quản_lý_quán_cafe.Models.ViewModels.Order.OrderDetailViewModel

@{
    var loyaltySubtotal = Model.LoyaltySubtotalAmount > 0 ? Model.LoyaltySubtotalAmount : Model.Subtotal;
    var staffName = ViewContext.HttpContext.Session.GetString("FullName") ?? ViewContext.HttpContext.User.Identity?.Name ?? "Nhân viên";

    // Map payment status to Vietnamese display
    string GetPaymentStatusDisplay(string status)
    {
        return status?.ToLower() switch
        {
            "completed" => "Đã thanh toán",
            "pending" => "Chờ thanh toán",
            "processing" => "Đang xử lý",
            "failed" => "Thất bại",
            "refunded" => "Đã hoàn tiền",
            _ => status ?? "Chưa rõ"
        };
    }

    // Determine payment status badge class
    string GetPaymentStatusClass(string status)
    {
        return status?.ToLower() switch
        {
            "completed" => "completed",
            "pending" => "pending",
            "processing" => "pending",
            "failed" => "failed",
            "refunded" => "failed",
            _ => "pending"
        };
    }
}

<div class="receipt" id="billPaper">
    <!-- HEADER -->
    <div class="receipt-header">
        <h2 class="cafe-name">BREWPOINT</h2>
        <p class="cafe-tagline">CAFE</p>
        <p class="receipt-title">HÓA ĐƠN THANH TOÁN</p>
    </div>

    <!-- META INFORMATION -->
    <div class="receipt-meta">
        <div class="receipt-meta-row">
            <div class="receipt-meta-item">
                <span class="receipt-meta-label">Mã hóa đơn</span>
                <span class="receipt-meta-value">#@Model.OrderCode</span>
            </div>
            <div class="receipt-meta-item">
                <span class="receipt-meta-label">Bàn</span>
                <span class="receipt-meta-value">@(string.IsNullOrEmpty(Model.TableNumber) ? "Mang đi" : Model.TableNumber)</span>
            </div>
        </div>

        <div class="receipt-meta-row">
            <div class="receipt-meta-item">
                <span class="receipt-meta-label">Ngày</span>
                <span class="receipt-meta-value">@Model.OrderDate.ToString("dd/MM/yyyy")</span>
            </div>
            <div class="receipt-meta-item">
                <span class="receipt-meta-label">Giờ</span>
                <span class="receipt-meta-value">@Model.OrderDate.ToString("HH:mm:ss")</span>
            </div>
        </div>

        <div class="receipt-meta-row full">
            <div class="receipt-meta-item">
                <span class="receipt-meta-label">Thu ngân</span>
                <span class="receipt-meta-value">@staffName</span>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.CustomerName) || !string.IsNullOrEmpty(Model.CustomerPhone))
        {
            <div class="receipt-meta-row full">
                @if (!string.IsNullOrEmpty(Model.CustomerName))
                {
                    <div class="receipt-meta-item">
                        <span class="receipt-meta-label">Khách hàng</span>
                        <span class="receipt-meta-value">@Model.CustomerName</span>
                    </div>
                }
            </div>
        }
    </div>

    <!-- DIVIDER -->
    <div class="receipt-divider dotted"></div>

    <!-- ITEMS LIST -->
    <div class="receipt-items">
        @foreach (var item in Model.Items)
        {
            <div class="receipt-item">
                <div class="receipt-item-details">
                    <p class="receipt-item-name">@item.ProductName</p>
                    <div class="receipt-item-info">
                        <div class="receipt-item-quantity">@item.Quantity × @item.UnitPrice.ToString("N0", new CultureInfo("vi-VN"))đ</div>
                        @if (!string.IsNullOrEmpty(item.Size))
                        {
                            <div class="receipt-item-quantity">@item.Size</div>
                        }
                        @if (!string.IsNullOrEmpty(item.Notes))
                        {
                            <div class="receipt-item-quantity" style="font-style: italic; color: #999;">@item.Notes</div>
                        }
                    </div>
                </div>
                <div class="receipt-item-price">
                    <div class="receipt-item-total">@item.TotalPrice.ToString("N0", new CultureInfo("vi-VN"))đ</div>
                </div>
            </div>
        }
    </div>

    <!-- DIVIDER -->
    <div class="receipt-divider dotted"></div>

    <!-- SUMMARY -->
    <div class="receipt-summary">
        @if (Model.PointDiscountAmount > 0 || Model.VoucherDiscountAmount > 0 || Model.Subtotal != Model.TotalAmount)
        {
            <div class="receipt-summary-row subtotal">
                <span class="receipt-summary-label">Tạm tính</span>
                <span class="receipt-summary-value">@loyaltySubtotal.ToString("N0", new CultureInfo("vi-VN"))đ</span>
            </div>
        }

        @if (Model.PointDiscountAmount > 0)
        {
            <div class="receipt-summary-row discount">
                <span class="receipt-summary-label discount-label">Đổi @Model.AppliedRewardPoints điểm</span>
                <span class="receipt-summary-value discount-value">-@Model.PointDiscountAmount.ToString("N0", new CultureInfo("vi-VN"))đ</span>
            </div>
        }

        @if (Model.VoucherDiscountAmount > 0)
        {
            <div class="receipt-summary-row discount">
                <span class="receipt-summary-label discount-label">Voucher @Model.AppliedVoucherCode</span>
                <span class="receipt-summary-value discount-value">-@Model.VoucherDiscountAmount.ToString("N0", new CultureInfo("vi-VN"))đ</span>
            </div>
        }

        <div class="receipt-summary-row total">
            <span class="receipt-summary-label">TỔNG CỘNG</span>
            <span class="receipt-summary-value">
                <span class="amount">@Model.TotalAmount.ToString("N0", new CultureInfo("vi-VN"))đ</span>
            </span>
        </div>
    </div>

    <!-- PAYMENT INFORMATION -->
    <div class="receipt-payment">
        <div class="receipt-payment-row">
            <span class="receipt-payment-label">Phương thức</span>
            <span class="receipt-payment-value">Tiền mặt</span>
        </div>
        <div class="receipt-payment-row">
            <span class="receipt-payment-label">Trạng thái</span>
            <span class="receipt-payment-value">
                <span class="receipt-payment-status @GetPaymentStatusClass(Model.PaymentStatus)">
                    @GetPaymentStatusDisplay(Model.PaymentStatus)
                </span>
            </span>
        </div>
        @if (Model.PaidDate.HasValue)
        {
            <div class="receipt-payment-row">
                <span class="receipt-payment-label">Thanh toán lúc</span>
                <span class="receipt-payment-value">@Model.PaidDate.Value.ToString("dd/MM/yyyy HH:mm")</span>
            </div>
        }
    </div>

    <!-- LOYALTY POINTS (if applicable) -->
    @if (Model.ProjectedEarnedPoints > 0)
    {
        <div class="receipt-loyalty">
            <div class="receipt-loyalty-row">
                <span class="receipt-loyalty-label">Điểm tích lũy</span>
                <span class="receipt-loyalty-value points">+@Model.ProjectedEarnedPoints</span>
            </div>
        </div>
    }

    <!-- FOOTER -->
    <div class="receipt-footer">
        <div class="receipt-footer-main">CẢM ƠN QUÝ KHÁCH!</div>
        <div class="receipt-footer-tagline">Hẹn gặp lại <span class="heart">❤️</span></div>
        <div class="receipt-footer-divider">─────────────────────</div>
        <div class="receipt-footer-branding">BREWPOINT CAFE • brewed with love</div>
    </div>
</div>

<script>
    function printBill() {
        window.print();
    }
</script>
