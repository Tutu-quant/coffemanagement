<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - BrewPoint</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/sweetalert2@11.7.0/dist/sweetalert2.min.css" />

    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" />

    <link rel="stylesheet"
          href="~/css/admin.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/tables.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/customer-order.css"
          asp-append-version="true" />

    @RenderSection("Head", required: false)
</head>
<body>
    <div class="admin-wrapper">

        @{
            var currentArea = ViewContext.RouteData.Values["area"]?.ToString() ?? "";
        }

        @if (currentArea == "Cashier")
        {
            @await Html.PartialAsync("_CashierSidebar")
        }
        else if (currentArea == "Customer")
        {
            @await Html.PartialAsync("_CustomerSidebar")
        }
        else
        {
            @await Html.PartialAsync("_AdminSidebar")
        }


        <div class="admin-main">
            @{
                var fullName = Context.Session.GetString("FullName") ?? string.Empty;
                var avatarInitial = string.IsNullOrWhiteSpace(fullName)
                    ? "A"
                    : fullName.Trim()[0].ToString().ToUpperInvariant();
            }
            <header class="admin-header">
                <div class="header-left">
                    <button type="button" class="btn-sidebar-toggle" id="sidebarToggle" aria-label="Mở menu điều hướng">
                        <i class="bi bi-list"></i>
                    </button>
                    <div class="header-title">
                        <h1>@ViewData["PageTitle"]</h1>
                        @if (ViewData["PageBreadcrumb"] != null)
                        {
                            <nav class="breadcrumb" aria-label="Đường dẫn trang">
                                <span class="breadcrumb-item">
                                    @if (currentArea == "Cashier")
                                    {
                                        <a href="@Url.Action("Index", "Dashboard", new { area = "Cashier" })"><i class="bi bi-house"></i> Tổng quan</a>
                                    }
                                    else if (currentArea == "Customer")
                                    {
                                        <a href="@Url.Action("Menu", "Orders", new { area = "Customer" })"><i class="bi bi-house"></i> Menu</a>
                                    }
                                    else
                                    {
                                        <a href="@Url.Action("Index", "Dashboard", new { area = "Admin" })"><i class="bi bi-house"></i> Tổng quan</a>
                                    }
                                </span>
                                @Html.Raw(ViewData["PageBreadcrumb"])
                            </nav>
                        }
                    </div>
                </div>
                <div class="header-right">
                    <div class="header-user">
                        <div class="user-avatar-small">@avatarInitial</div>
                        <div class="user-info-small">
                            <p class="user-name-small">@fullName</p>
                            <p class="user-role-small">@(currentArea == "Cashier" ? "Thu ngân" : Context.Session.GetString("RoleName"))</p>
                        </div>
                    </div>
                </div>
            </header>

            <main class="admin-content">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }

                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.7.0/dist/sweetalert2.min.js"></script>
    <script src="~/js/admin.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.7/dist/browser/signalr.min.js"></script>
    <script src="~/js/realtime.js" asp-append-version="true"></script>
</body>
</html>
