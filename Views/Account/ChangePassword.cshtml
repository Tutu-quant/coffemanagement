@{
    ViewData["Title"] = "Đổi mật khẩu";
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Đổi mật khẩu - BrewPoint</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
</head>
<body>
    <main class="min-vh-100 d-flex align-items-center justify-content-center p-3">
        <section class="card shadow-sm border-0" style="max-width: 520px; width: 100%;">
            <div class="card-body p-4 p-md-5">
                <h1 class="h3 mb-3">Đổi mật khẩu</h1>

                @if (TempData["ChangePasswordMessage"] != null)
                {
                    <div class="alert alert-info">@TempData["ChangePasswordMessage"]</div>
                    <a asp-controller="Account" asp-action="Login" class="btn btn-primary w-100">Quay lại đăng nhập</a>
                }
                else
                {
                    <form method="post" asp-action="ChangePassword">
                        <div class="mb-3">
                            <label class="form-label">Mật khẩu mới</label>
                            <input name="newPassword" type="password" class="form-control" required minlength="6" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Nhập lại mật khẩu</label>
                            <input name="confirmPassword" type="password" class="form-control" required minlength="6" />
                        </div>
                        <button type="submit" class="btn btn-primary w-100">Cập nhật mật khẩu</button>
                    </form>
                }
            </div>
        </section>
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
