@{
    ViewData["Title"] = "Quên mật khẩu";
    Layout = null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Quên mật khẩu - BrewPoint</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
</head>
<body>
    <main class="min-vh-100 d-flex align-items-center justify-content-center p-3">
        <section class="card shadow-sm border-0" style="max-width: 520px; width: 100%;">
            <div class="card-body p-4 p-md-5">
                <h1 class="h3 mb-3">Khôi phục mật khẩu</h1>
                <p class="text-muted">Hệ thống chưa cấu hình dịch vụ gửi email đặt lại mật khẩu. Vui lòng liên hệ quản trị viên để xác minh và cấp lại mật khẩu.</p>
                <a asp-controller="Account" asp-action="Login" class="btn btn-primary w-100">Quay lại đăng nhập</a>
            </div>
        </section>
    </main>
</body>
</html>
