@model OrderDetailViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>In hóa đơn - BrewPoint</title>
    <link rel="stylesheet" href="~/css/receipt.css" asp-append-version="true" />
    <style>
        html, body {
            margin: 0;
            padding: 0;
            background-color: #fafafa;
        }
    </style>
</head>
<body>
    <div class="receipt-page">
        <div class="receipt-actions no-print">
            <a class="btn btn-outline-secondary" href="@((ViewData["ReturnUrl"] as string) ?? Url.Action("Details", "Orders", new { id = Model.OrderId, area = "Admin" }))">
                <i class="bi bi-arrow-left"></i> Quay lại
            </a>
            <button type="button" class="btn btn-print" onclick="window.print()">
                <i class="bi bi-printer"></i> In hóa đơn
            </button>
        </div>

        @await Html.PartialAsync("~/Views/Shared/_Bill.cshtml", Model)
    </div>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />

    <script>
        window.addEventListener('load', function() {
            // Auto-print after 300ms if opened directly
            // Uncomment if you want auto-print on page load
            // setTimeout(() => {
            //     window.print();
            // }, 300);
        });
    </script>
</body>
</html>
