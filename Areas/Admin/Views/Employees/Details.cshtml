@model EmployeeDetailViewModel

@{
    ViewData["Title"] = "Chi tiết nhân viên";
    ViewData["PageTitle"] = "Chi tiết nhân viên";
    ViewData["PageBreadcrumb"] = "<span class='breadcrumb-item'><a href='" + Url.Action("Index", "Employees", new { area = "Admin" }) + "'><i class='bi bi-people'></i> Nhân viên</a></span><span class='breadcrumb-item'>Chi tiết</span>";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-header">
    <a href="@Url.Action("Index")" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Quay lại
    </a>
    <div class="d-flex gap-2">
        <a href="@Url.Action("Edit", new { id = Model.EmployeeID })" class="btn btn-warning">
            <i class="bi bi-pencil"></i> Chỉnh sửa
        </a>
        <a href="@Url.Action("ChangePassword", new { id = Model.EmployeeID })" class="btn btn-secondary">
            <i class="bi bi-key"></i> Đổi mật khẩu
        </a>
    </div>
</div>

<div class="row">
    <div class="col-lg-4">
        <!-- Employee Card -->
        <div class="card">
            <div class="card-body text-center">
                <div class="employee-avatar-large">
                    @Model.FullName.First()
                </div>
                <h4 class="mt-3 mb-0">@Model.FullName</h4>
                <p class="text-muted mb-3">@Model.Position</p>

                @if (Model.IsActive)
                {
                    <span class="badge bg-success">
                        <i class="bi bi-check-circle"></i>
                        Hoạt động
                    </span>
                }
                else
                {
                    <span class="badge bg-warning">
                        <i class="bi bi-exclamation-circle"></i>
                        Không hoạt động
                    </span>
                }

                <hr class="my-3" />

                <div class="employee-contact-info">
                    <div class="contact-item">
                        <i class="bi bi-envelope"></i>
                        <div>
                            <p class="contact-label">Email</p>
                            <p class="contact-value">@Model.Email</p>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.Phone))
                    {
                        <div class="contact-item">
                            <i class="bi bi-telephone"></i>
                            <div>
                                <p class="contact-label">Số điện thoại</p>
                                <p class="contact-value">@Model.Phone</p>
                            </div>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(Model.Address))
                    {
                        <div class="contact-item">
                            <i class="bi bi-geo-alt"></i>
                            <div>
                                <p class="contact-label">Địa chỉ</p>
                                <p class="contact-value">@Model.Address</p>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <!-- Information Cards -->
        <div class="card mb-4">
            <div class="card-header">
                <h6 class="mb-0">
                    <i class="bi bi-briefcase"></i> Thông tin công việc
                </h6>
            </div>
            <div class="card-body">
                <div class="info-grid">
                    <div class="info-item">
                        <label>Chức vụ</label>
                        <p>@Model.Position</p>
                    </div>
                    <div class="info-item">
                        <label>Phòng ban</label>
                        <p>@Model.Department</p>
                    </div>
                    <div class="info-item">
                        <label>Ngày tuyển dụng</label>
                        <p>
                            @if (Model.HireDate.HasValue)
                            {
                                @Model.HireDate.Value.ToString("dd/MM/yyyy")
                            }
                            else
                            {
                                <span class="text-muted">Chưa cập nhật</span>
                            }
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Account Information -->
        <div class="card mb-4">
            <div class="card-header">
                <h6 class="mb-0">
                    <i class="bi bi-lock"></i> Thông tin tài khoản
                </h6>
            </div>
            <div class="card-body">
                <div class="info-grid">
                    <div class="info-item">
                        <label>Tên đăng nhập</label>
                        <p class="monospace">@Model.Username</p>
                    </div>
                    <div class="info-item">
                        <label>ID người dùng</label>
                        <p class="monospace">@Model.UserID</p>
                    </div>
                    <div class="info-item">
                        <label>Ngày tạo</label>
                        <p>@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</p>
                    </div>
                    <div class="info-item">
                        <label>Cập nhật lần cuối</label>
                        <p>
                            @if (Model.UpdatedAt.HasValue)
                            {
                                @Model.UpdatedAt.Value.ToString("dd/MM/yyyy HH:mm")
                            }
                            else
                            {
                                <span class="text-muted">Chưa cập nhật</span>
                            }
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Head {
