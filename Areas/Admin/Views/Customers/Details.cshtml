@using Quản_lý_quán_cafe.Models.ViewModels.Customer
@using Quản_lý_quán_cafe.Models
@model CustomerDetailViewModel

@{
    ViewData["Title"] = "Chi tiết khách hàng";
    ViewData["PageTitle"] = "Chi tiết khách hàng";
    ViewData["PageBreadcrumb"] = "<span class='breadcrumb-item'><a href='" + Url.Action("Index") + "'><i class='bi bi-people'></i> Khách hàng</a></span><span class='breadcrumb-item'><i class='bi bi-info-circle'></i> Chi tiết</span>";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-header">
    <div>
        <p style="color: var(--text-light); margin: 0; font-size: 14px;">BrewPoint Cafe · Quản trị</p>
    </div>
    <div class="d-flex gap-2">
        <a href="@Url.Action("Index")" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i>
            Quay lại
        </a>
        <a href="@Url.Action("Edit", new { id = Model?.Id })" class="btn btn-warning">
            <i class="bi bi-pencil"></i>
            Chỉnh sửa
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @successMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
    </div>
}
@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @errorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
    </div>
}

<div class="row">
    <div class="col-lg-8">

        <div class="card mb-4">
            <div class="card-header">
                <h5 class="card-title mb-0">
                    <i class="bi bi-person"></i> Thông tin cá nhân
                </h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-4 text-center mb-4">
                        <div class="avatar-circle-large mb-2">
                            @Model?.AvatarInitials
                        </div>
                        <p class="text-muted">@Model?.Name</p>
                    </div>
                    <div class="col-md-8">
                        <div class="row mb-3">
                            <div class="col-6">
                                <label class="text-muted small">Họ tên</label>
                                <p class="mb-0">@Model?.Name</p>
                            </div>
                            <div class="col-6">
                                <label class="text-muted small">Số điện thoại</label>
                                <p class="mb-0">
                                    <i class="bi bi-telephone"></i>
                                    @Model?.Phone
                                </p>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-6">
                                <label class="text-muted small">Email</label>
                                <p class="mb-0">@Model?.Email</p>
                            </div>
                            <div class="col-6">
                                <label class="text-muted small">Tài khoản đăng nhập</label>
                                <p class="mb-0"><i class="bi bi-person-badge"></i> @(Model?.Username ?? "Chưa liên kết")</p>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-12">
                                <label class="text-muted small">Địa chỉ</label>
                                <p class="mb-0">@Model?.Address</p>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-6">
                                <label class="text-muted small">Ngày tham gia</label>
                                <p class="mb-0">@(Model is null ? "-" : BusinessClock.FromUtc(Model.CreatedAt).ToString("dd/MM/yyyy"))</p>
                            </div>
                            <div class="col-6">
                                <label class="text-muted small">Trạng thái</label>
                                <p class="mb-0">
                                    @if (Model?.IsActive == true)
                                    {
                                        <span class="badge bg-success">Hoạt động</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Ngừng hoạt động</span>
                                    }
                                </p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>


        @if (Model?.RecentOrders?.Count > 0)
        {
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-bag"></i> 5 đơn hàng gần nhất
                    </h5>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Mã đơn</th>
                                <th>Ngày mua</th>
                                <th>Tổng tiền</th>
                                <th>Trạng thái</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model.RecentOrders)
                            {
                                <tr>
                                    <td><strong>#@order.Id</strong></td>
                                    <td>@BusinessClock.FromUtc(order.CreatedAt).ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@order.TotalAmount.ToString("N0")₫</td>
                                    <td>
                                        <span class="badge bg-info text-dark">@order.Status</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0"><i class="bi bi-clock-history"></i> Lịch sử điểm</h5>
                <span class="badge text-bg-light">@(Model?.PointHistory.Count ?? 0) giao dịch gần nhất</span>
            </div>
            @if (Model!.PointHistory.Count == 0)
            {
                <div class="card-body text-center text-muted py-4">Chưa có giao dịch điểm.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Thời gian</th>
                                <th>Nội dung</th>
                                <th>Đơn</th>
                                <th class="text-end">Số dư</th>
                                <th class="text-end">Thay đổi</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var item in Model.PointHistory)
                        {
                            var isCredit = item.Points >= 0;
                            <tr>
                                <td class="text-nowrap">@BusinessClock.FromUtc(item.TransactionDate).ToString("HH:mm · dd/MM/yyyy")</td>
                                <td>
                                    <strong>@PointTypeLabel(item.TransactionType)</strong>
                                    @if (!string.IsNullOrWhiteSpace(item.Description))
                                    {
                                        <div class="small text-muted">@item.Description</div>
                                    }
                                </td>
                                <td>
                                    @if (item.OrderId.HasValue)
                                    {
                                        <a asp-area="Admin" asp-controller="Orders" asp-action="Details" asp-route-id="@item.OrderId">#@item.OrderId</a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="text-end">@item.BalanceAfter.ToString("N0")</td>
                                <td class="text-end fw-bold @(isCredit ? "text-success" : "text-danger")">
                                    @(isCredit ? "+" : string.Empty)@item.Points.ToString("N0")
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>


    <div class="col-lg-4">

        <div class="card mb-4 border-0 shadow-sm" style="overflow: hidden;">
            <div class="card-body text-white" style="background: linear-gradient(135deg, #4a2b1d, #7a4b31);">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="small text-uppercase opacity-75">Điểm khả dụng</div>
                        <div class="display-6 fw-bold">@Model.RewardPoints.ToString("N0")</div>
                        <div class="small opacity-75">Tương đương @((Model.RewardPoints * 100m).ToString("N0"))đ</div>
                    </div>
                    <i class="bi bi-stars fs-2"></i>
                </div>
            </div>
            <div class="card-body">
                <h6 class="mb-3">Tặng điểm cho tài khoản</h6>
                <form asp-area="Admin" asp-controller="Customers" asp-action="GiftPoints" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label for="giftPoints" class="form-label">Số điểm</label>
                        <input id="giftPoints" name="Points" type="number" min="1" max="1000000" step="1"
                               class="form-control" required disabled="@(string.IsNullOrWhiteSpace(Model.Username) || !Model.IsActive)" />
                    </div>
                    <div class="mb-3">
                        <label for="giftReason" class="form-label">Lý do</label>
                        <textarea id="giftReason" name="Reason" rows="2" maxlength="300" class="form-control"
                                  placeholder="Ví dụ: Chăm sóc khách hàng"
                                  disabled="@(string.IsNullOrWhiteSpace(Model.Username) || !Model.IsActive)"></textarea>
                    </div>
                    <button type="submit" class="btn btn-primary w-100"
                            disabled="@(string.IsNullOrWhiteSpace(Model.Username) || !Model.IsActive)"
                            onclick="return confirm('Xác nhận tặng điểm cho tài khoản này?');">
                        <i class="bi bi-gift"></i> Tặng điểm
                    </button>
                </form>
                @if (string.IsNullOrWhiteSpace(Model.Username))
                {
                    <div class="small text-warning mt-2">Khách hàng chưa liên kết tài khoản đăng nhập nên chưa thể nhận điểm.</div>
                }
                else if (!Model.IsActive)
                {
                    <div class="small text-warning mt-2">Tài khoản đang ngừng hoạt động.</div>
                }
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header">
                <h5 class="card-title mb-0">
                    <i class="bi bi-cash"></i> Tổng chi tiêu
                </h5>
            </div>
            <div class="card-body">
                <div class="text-center">
                    <p class="text-muted small mb-1">Tất cả đơn hàng</p>
                    <p style="font-size: 24px; font-weight: bold; color: #4CAF50; margin: 0;">
                        @Model?.TotalSpent.ToString("N0")₫
                    </p>
                </div>
            </div>
        </div>


        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">
                    <i class="bi bi-graph-up"></i> Số đơn hàng
                </h5>
            </div>
            <div class="card-body">
                <div class="text-center">
                    <p class="text-muted small mb-1">Tổng cộng</p>
                    <p style="font-size: 28px; font-weight: bold; color: #667EEA; margin: 0;">
                        @Model?.RecentOrders?.Count ?? 0
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@functions {
    private static string PointTypeLabel(string? type) => type?.Trim().ToLowerInvariant() switch
    {
        "earned" or "earn" => "Cộng từ hóa đơn",
        "redeemed" or "redeem" => "Đổi điểm",
        "gift" or "granted" or "grant" => "Admin tặng điểm",
        "refund" or "refunded" => "Hoàn điểm",
        _ => string.IsNullOrWhiteSpace(type) ? "Điều chỉnh" : type
    };
}

@section Head {
    <link rel="stylesheet" href="~/css/customers.css" asp-append-version="true" />
}
