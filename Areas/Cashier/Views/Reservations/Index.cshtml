@model IReadOnlyList<Quản_lý_quán_cafe.Models.Entities.Reservation>
@{
    ViewData["Title"] = "Lịch đặt bàn";
    var currentStatus = ViewBag.Status as string;
    var pageNumber = (int)(ViewBag.PageNumber ?? 1);
    var totalPages = (int)(ViewBag.TotalPages ?? 1);
    var totalItems = (int)(ViewBag.TotalItems ?? 0);
    string BadgeClass(string status) => status switch
    {
        "Pending" => "text-bg-warning",
        "Confirmed" => "text-bg-primary",
        "CheckedIn" => "text-bg-info",
        "Completed" => "text-bg-success",
        "Cancelled" => "text-bg-secondary",
        _ => "text-bg-light"
    };
    string StatusLabel(string status) => status switch
    {
        "Pending" => "Chờ xác nhận",
        "Confirmed" => "Đã xác nhận",
        "CheckedIn" => "Đã nhận bàn",
        "Completed" => "Hoàn tất",
        "Cancelled" => "Đã hủy",
        _ => status
    };
}

<div class="container-fluid p-3 p-lg-4">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3 mb-4">
        <div>
            <h1 class="h3 mb-1" style="color: var(--primary-color);">Lịch đặt bàn</h1>
            <p class="text-muted mb-0">Theo dõi các yêu cầu đặt bàn từ khách hàng.</p>
        </div>
        <span class="badge rounded-pill text-bg-light border px-3 py-2">@totalItems lịch</span>
    </div>

    <nav class="d-flex flex-wrap gap-2 mb-3" aria-label="Lọc trạng thái lịch đặt bàn">
        <a asp-action="Index" class="btn btn-sm @(currentStatus is null ? "btn-dark" : "btn-outline-secondary")">Tất cả</a>
        <a asp-action="Index" asp-route-status="Pending" class="btn btn-sm @(currentStatus == "Pending" ? "btn-warning" : "btn-outline-warning")">Chờ xác nhận</a>
        <a asp-action="Index" asp-route-status="Confirmed" class="btn btn-sm @(currentStatus == "Confirmed" ? "btn-primary" : "btn-outline-primary")">Đã xác nhận</a>
        <a asp-action="Index" asp-route-status="CheckedIn" class="btn btn-sm @(currentStatus == "CheckedIn" ? "btn-info" : "btn-outline-info")">Đã nhận bàn</a>
        <a asp-action="Index" asp-route-status="Completed" class="btn btn-sm @(currentStatus == "Completed" ? "btn-success" : "btn-outline-success")">Hoàn tất</a>
        <a asp-action="Index" asp-route-status="Cancelled" class="btn btn-sm @(currentStatus == "Cancelled" ? "btn-secondary" : "btn-outline-secondary")">Đã hủy</a>
    </nav>

    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Mã</th>
                        <th scope="col">Khách hàng</th>
                        <th scope="col">Bàn</th>
                        <th scope="col">Thời gian</th>
                        <th scope="col">Số khách</th>
                        <th scope="col">Trạng thái</th>
                        <th scope="col" class="text-end">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="fas fa-calendar-xmark d-block mb-2" style="font-size: 2rem;"></i>
                            Không có lịch đặt bàn phù hợp.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var reservation in Model)
                    {
                        <tr>
                            <td class="fw-semibold">#@reservation.ReservationID</td>
                            <td>
                                <div class="fw-semibold">@(reservation.Customer?.CustomerName ?? "Khách hàng")</div>
                                <small class="text-muted">@(reservation.Customer?.Phone ?? reservation.Customer?.Email ?? "Chưa có liên hệ")</small>
                            </td>
                            <td>
                                <div class="fw-semibold">@(reservation.Table?.TableNumber ?? "N/A")</div>
                                <small class="text-muted">@reservation.Table?.Location</small>
                            </td>
                            <td>
                                <time datetime="@reservation.ReservationDate.ToString("yyyy-MM-ddTHH:mm:ss")">
                                    <span class="d-block fw-semibold">@reservation.ReservationDate.ToString("HH:mm")</span>
                                    <small class="text-muted">@reservation.ReservationDate.ToString("dd/MM/yyyy")</small>
                                </time>
                            </td>
                            <td>@reservation.NumberOfGuests người</td>
                            <td><span class="badge @BadgeClass(reservation.ReservationStatus)">@StatusLabel(reservation.ReservationStatus)</span></td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@reservation.ReservationID" class="btn btn-sm btn-outline-primary">
                                    <i class="fas fa-eye" aria-hidden="true"></i> Xem
                                </a>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
    </div>

    @if (totalPages > 1)
    {
        <nav class="mt-3" aria-label="Phân trang lịch đặt bàn">
            <ul class="pagination pagination-sm justify-content-center mb-0">
                <li class="page-item @(pageNumber <= 1 ? "disabled" : null)">
                    <a class="page-link" asp-action="Index" asp-route-status="@currentStatus" asp-route-pageNumber="@(pageNumber - 1)">Trước</a>
                </li>
                @for (var page = Math.Max(1, pageNumber - 2); page <= Math.Min(totalPages, pageNumber + 2); page++)
                {
                    <li class="page-item @(page == pageNumber ? "active" : null)">
                        <a class="page-link" asp-action="Index" asp-route-status="@currentStatus" asp-route-pageNumber="@(page)">@(page)</a>
                    </li>
                }
                <li class="page-item @(pageNumber >= totalPages ? "disabled" : null)">
                    <a class="page-link" asp-action="Index" asp-route-status="@currentStatus" asp-route-pageNumber="@(pageNumber + 1)">Sau</a>
                </li>
            </ul>
        </nav>
    }
</div>
