@model Quản_lý_quán_cafe.Areas.Cashier.ViewModels.PaymentsViewModel

@{
    ViewData["Title"] = "Thanh toán";
    ViewData["PageTitle"] = "Thanh toán";
    ViewData["PageBreadcrumb"] = "<span class='breadcrumb-item'><i class='bi bi-cash-coin'></i> Thanh toán</span>";
}

<div class="page-header-cashier">
    <h1 class="page-title">💳 Quản lý thanh toán</h1>
</div>

<div class="row">
    <div class="col-md-4">
        <div class="card shadow-sm border-0">
            <div class="card-body text-center">
                <h3 class="card-title text-success">@String.Format(System.Globalization.CultureInfo.GetCultureInfo("vi-VN"), "{0:N0}đ", Model.TotalPaidToday)</h3>
                <p class="card-text text-muted">Đã thanh toán hôm nay</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm border-0">
            <div class="card-body text-center">
                <h3 class="card-title text-warning">@String.Format(System.Globalization.CultureInfo.GetCultureInfo("vi-VN"), "{0:N0}đ", Model.PendingAmount)</h3>
                <p class="card-text text-muted">Chờ thanh toán</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm border-0">
            <div class="card-body text-center">
                <h3 class="card-title text-primary">@Model.TransactionCountToday</h3>
                <p class="card-text text-muted">Giao dịch hôm nay</p>
            </div>
        </div>
    </div>
</div>

<div class="card mt-4">
    <div class="card-header">
        <h5 class="mb-0">Lịch sử giao dịch</h5>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover">
                <thead class="table-light">
                    <tr>
                        <th>Mã đơn</th>
                        <th>Loại thanh toán</th>
                        <th class="text-end">Số tiền</th>
                        <th>Thời gian</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Transactions == null || !Model.Transactions.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted py-4">
                                <i class="bi bi-inbox"></i> Chưa có dữ liệu
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var t in Model.Transactions)
                        {
                            <tr>
                                <td><strong style="color:var(--coffee-brown);">@(t.OrderCode ?? "-")</strong></td>
                                <td>
                                    @if (t.PaymentMethod?.ToLowerInvariant().Contains("qr") == true)
                                    {
                                        <span class="badge bg-info text-dark">QR</span>
                                    }
                                    else if (t.PaymentMethod?.ToLowerInvariant().Contains("cash") == true)
                                    {
                                        <span class="badge bg-success">Tiền mặt</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@t.PaymentMethod</span>
                                    }
                                </td>
                                <td class="text-end"><span class="fw-bold text-primary">@String.Format(System.Globalization.CultureInfo.GetCultureInfo("vi-VN"), "{0:N0}đ", t.Amount)</span></td>
                                <td>@t.Time.ToString("dd/MM/yyyy HH:mm:ss")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
