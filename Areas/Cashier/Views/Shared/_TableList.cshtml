@model List<POSTableViewModel>

<div class="pos-sidebar">
    <div class="pos-logo">
        <i class="bi bi-cup-hot"></i>
        <div>
            <div class="logo-brand">BrewPoint POS</div>
            <div class="logo-tagline">Quản lý bàn</div>
        </div>
    </div>

    <div class="pos-search">
        <input type="text" class="form-control" placeholder="🔍 Tìm bàn..." id="searchTable" />
    </div>

    <div class="tables-list">
        @if (Model == null || Model.Count == 0)
        {
            <div class="empty-state">
                <i class="bi bi-inbox"></i>
                <p>Không có bàn nào mở</p>
            </div>
        }
        else
        {
            @foreach (var table in Model)
            {
                var key = (table.Status ?? "").ToLowerInvariant();
                var statusText = key switch
                {
                    "occupied" => "Có khách",
                    "waitingpayment" => "Chờ thanh toán",
                    "reserved" => "Đã đặt",
                    "maintenance" => "Bảo trì",
                    _ => "Trống"
                };
                <div class="table-item @key @(table.IsSelected ? "active" : "")" data-table-id="@table.TableID"
                     role="button" tabindex="0" aria-current="@(table.IsSelected ? "true" : "false")"
                     onclick="selectTable(@table.TableID)"
                     onkeydown="if (event.target === event.currentTarget && (event.key === 'Enter' || event.key === ' ')) { event.preventDefault(); selectTable(@table.TableID); }">
                    <div class="table-header">
                        <div class="table-info">
                            <div class="table-name">@table.TableName</div>
                            <div class="table-code">@table.OrderCode - @table.ItemCount món · <span style="font-weight:600">@statusText</span></div>
                        </div>
                        <div class="table-price">@table.TotalAmount.ToString("N0")đ</div>
                    </div>
                    <div class="table-actions mt-2 d-flex justify-content-between align-items-center">
                        <div>
                            @if (!string.IsNullOrEmpty(table.StatusBadge))
                            {
                                <div class="table-badge">@table.StatusBadge</div>
                            }
                        </div>
                        @if (key == "reserved")
                        {
                            <span class="small text-white-50">Nhận bàn khi thêm món</span>
                        }
                        else
                        {
                        <div class="btn-group btn-group-sm" role="group" aria-label="Đổi trạng thái @table.TableName" style="gap:6px;">
                            <button type="button" class="btn btn-outline-light btn-sm p-1 rounded-circle" title="Đặt bàn trống" onclick="event.stopPropagation(); changeTableStatus(@table.TableID, 'Available')">
                                <i class="bi bi-check-lg"></i>
                            </button>
                            <button type="button" class="btn btn-outline-light btn-sm p-1 rounded-circle" title="Đặt bàn có khách" onclick="event.stopPropagation(); changeTableStatus(@table.TableID, 'Occupied')">
                                <i class="bi bi-person-fill"></i>
                            </button>
                            <button type="button" class="btn btn-outline-light btn-sm p-1 rounded-circle" title="Chờ thanh toán" onclick="event.stopPropagation(); changeTableStatus(@table.TableID, 'WaitingPayment')">
                                <i class="bi bi-hourglass-split"></i>
                            </button>
                            <button type="button" class="btn btn-outline-light btn-sm p-1 rounded-circle" title="Bảo trì" onclick="event.stopPropagation(); changeTableStatus(@table.TableID, 'Maintenance')">
                                <i class="bi bi-tools"></i>
                            </button>
                        </div>
                        }
                    </div>
                </div>
            }
        }
    </div>

    <div class="pos-footer">
        <a href="@Url.Action("Index", "Dashboard", new { area = "Cashier" })" class="btn-back">
            <i class="bi bi-chevron-left"></i> Nhân viên
        </a>
    </div>
</div>
