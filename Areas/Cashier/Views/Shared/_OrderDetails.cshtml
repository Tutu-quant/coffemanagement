@model Quản_lý_quán_cafe.Areas.Cashier.ViewModels.POSViewModel


<div class="pos-main">
    @if (Model.CurrentTable != null)
    {

        <div class="order-header">
            <div>
                <h2>@Model.CurrentTable.TableName — @Model.CurrentTable.OrderCode</h2>
                <p class="text-muted">@Model.OrderItems.Count() món</p>
            </div>
            <button type="button" class="btn-close" onclick="closeTable()">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>

        <!-- Show list of orders for this table if user clicks "Xem các đơn khác" -->
        <div id="ordersList" style="display:none; margin-bottom: 15px;">
            <div class="card border-0 bg-light">
                <div class="card-body p-3">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <strong><i class="bi bi-list"></i> Các đơn của bàn</strong>
                        <button type="button" class="btn-sm btn-link" onclick="hideOrdersList()">Ẩn</button>
                    </div>
                    <div id="ordersListContainer" style="max-height: 200px; overflow-y: auto;">
                        <!-- Will be populated by JavaScript -->
                    </div>
                </div>
            </div>
        </div>

        @if (Model.CurrentTable.OrderStatus is null or "Pending" or "Preparing")
        {
        <div class="card border-0 bg-light mb-3">
            <div class="card-body p-3">
                <div class="d-flex align-items-center justify-content-between mb-2">
                    <strong><i class="bi bi-cup-hot"></i> Thêm món</strong>
                    <small class="text-muted">@Model.Products.Count món đang bán</small>
                </div>
                <div class="row g-2" style="max-height: 260px; overflow-y: auto;">
                    @foreach (var product in Model.Products)
                    {
                        <div class="col-md-6">
                            <button type="button" class="btn btn-outline-dark w-100 text-start p-2"
                                    onclick="addProduct(@product.ProductID, this)">
                                <span class="d-flex justify-content-between gap-2">
                                    <span>
                                        <strong class="d-block">@product.ProductName</strong>
                                        <small class="text-muted">@product.CategoryName · còn @product.Quantity</small>
                                    </span>
                                    <strong class="text-nowrap">@product.Price.ToString("N0")đ</strong>
                                </span>
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
        }
        else if (Model.CurrentTable.OrderStatus == "Ready")
        {
            <div class="alert alert-danger mb-3">
                <strong><i class="bi bi-exclamation-circle"></i> Đơn này đã sẵn sàng</strong>
                <p class="mb-2">Không thể chỉnh sửa hoặc thêm món vào đơn này.</p>
                <button type="button" class="btn btn-sm btn-primary" onclick="createNewOrder()">
                    <i class="bi bi-plus-circle"></i> Tạo đơn mới
                </button>
            </div>
        }
        else if (Model.CurrentTable.OrderStatus == "Completed" || Model.CurrentTable.OrderStatus == "WaitingPayment" || Model.CurrentTable.OrderStatus == "Cancelled")
        {
            <div class="alert alert-info mb-3">
                <strong><i class="bi bi-info-circle"></i> Đơn đã kết thúc</strong>
                <p class="mb-2">Đơn ở trạng thái <strong>@Model.CurrentTable.OrderStatus</strong> không thể sửa đổi.</p>
                <button type="button" class="btn btn-sm btn-primary" onclick="createNewOrder()">
                    <i class="bi bi-plus-circle"></i> Tạo đơn mới cho bàn
                </button>
            </div>
        }
        else
        {
            <div class="alert alert-warning mb-3">
                Đơn ở trạng thái <strong>@Model.CurrentTable.OrderStatus</strong>; không thể thêm hoặc sửa món.
            </div>
        }

        <div class="order-items-section">
            <div class="section-header">
                <div class="col-name">MÓN</div>
                <div class="col-qty">SL</div>
                <div class="col-price">GIÁ</div>
            </div>

            <div class="order-items" id="orderItems">
                @if (!Model.OrderItems.Any())
                {
                    <div class="empty-order">
                        <p>Chưa có món nào</p>
                    </div>
                }
                else
                {
                    @foreach (var item in Model.OrderItems)
                    {
                        <div class="order-item" data-item-id="@item.OrderDetailID">
                            <div class="item-main">
                                <div class="item-info">
                                    <div class="item-name">@item.ProductName</div>
                                    <div class="item-size">Cỡ @item.Size</div>
                                    @if (!string.IsNullOrEmpty(item.Notes))
                                    {
                                        <div class="item-notes">@item.Notes</div>
                                    }
                                </div>
                                <div class="item-controls">
                                    @if (Model.CurrentTable.OrderStatus == "Pending")
                                    {
                                    <button type="button" class="qty-btn" onclick="decreaseQty(@item.OrderDetailID)">−</button>
                                    <span class="qty">@item.Quantity</span>
                                    <button type="button" class="qty-btn" onclick="increaseQty(@item.OrderDetailID)">+</button>
                                    }
                                    else
                                    {
                                        <span class="qty">@item.Quantity</span>
                                    }
                                </div>
                                <div class="item-price">@item.Total.ToString("N0")đ</div>
                                @if (Model.CurrentTable.OrderStatus == "Pending")
                                {
                                <button type="button" class="btn-remove" onclick="removeItem(@item.OrderDetailID)">
                                    <i class="bi bi-trash"></i>
                                </button>
                                }
                            </div>
                        </div>
                    }
                }
            </div>
        </div>

        <!-- Button to show other orders for this table -->
        <div style="margin-bottom: 15px;">
            <button type="button" class="btn btn-sm btn-outline-secondary w-100" onclick="showOrdersList()">
                <i class="bi bi-list-ul"></i> Xem các đơn khác của bàn này
            </button>
        </div>


        <div class="customer-section">
            <div class="section-header">
                <h3>Tài khoản và ưu đãi</h3>
            </div>
            @if (Model.Customer?.CustomerID.HasValue == true)
            {
                <div class="customer-info">
                    <div>
                        <div class="customer-name">@Model.Customer.Name</div>
                        <div class="customer-phone">@Model.Customer.Phone</div>
                        @if (!string.IsNullOrWhiteSpace(Model.Customer.Email))
                        {
                            <div class="customer-phone"><a href="mailto:@Model.Customer.Email">@Model.Customer.Email</a></div>
                        }
                    </div>
                    <span class="loyalty-points-badge">
                        <i class="bi bi-stars" aria-hidden="true"></i>
                        @Model.Customer.RewardPoints.ToString("N0") điểm
                    </span>
                </div>
            }
            else
            {
                <div class="loyalty-guest-note">
                    <i class="bi bi-person" aria-hidden="true"></i>
                    Đơn hiện chưa gắn tài khoản khách hàng.
                </div>
            }

            <div class="loyalty-panel" data-order-id="@(Model.CurrentTable.OrderID?.ToString() ?? string.Empty)">
                <div class="loyalty-mode-note">
                    Chỉ áp dụng một loại ưu đãi cho mỗi đơn: toàn bộ điểm của các tài khoản đã chọn hoặc một voucher.
                </div>

                <label class="loyalty-label" for="loyaltyAccountQuery">Tìm tài khoản dùng điểm</label>
                <div class="search-customer">
                    <input type="search" class="form-control" id="loyaltyAccountQuery"
                           placeholder="Số điện thoại hoặc tên tài khoản"
                           autocomplete="off" inputmode="search"
                           @(!Model.CurrentTable.OrderID.HasValue ? "disabled" : null) />
                    <button type="button" class="btn btn-sm btn-outline-secondary" id="searchLoyaltyAccountsButton"
                            onclick="searchLoyaltyAccounts()"
                            @(!Model.CurrentTable.OrderID.HasValue ? "disabled" : null)>
                        <i class="bi bi-search" aria-hidden="true"></i> Tìm
                    </button>
                </div>
                <div id="loyaltyAccountSearchStatus" class="loyalty-status" role="status" aria-live="polite"></div>
                <div id="loyaltyAccountResults" class="loyalty-search-results" role="list" hidden></div>

                <div class="loyalty-selection">
                    <div class="loyalty-selection-heading">
                        <span>Tài khoản đã chọn</span>
                        <span id="selectedLoyaltyAccountCount">0</span>
                    </div>
                    <p id="selectedLoyaltyAccountsEmpty" class="loyalty-empty">Chưa chọn tài khoản nào.</p>
                    <div id="selectedLoyaltyAccounts" class="loyalty-selected-accounts"></div>
                    <button type="button" class="btn-apply-points" id="applyAllPointsButton"
                            onclick="applySelectedPoints()" disabled>
                        <i class="bi bi-gift" aria-hidden="true"></i>
                        Áp dụng toàn bộ điểm
                    </button>
                    <small>Dùng lần lượt theo thứ tự đã chọn; hệ thống chỉ trừ số điểm cần thiết và giữ lại phần dư.</small>
                </div>

                <div class="voucher-section">
                    <label class="loyalty-label" for="voucherCode">Voucher</label>
                    <div class="voucher-input-group">
                        <input type="text" class="form-control" id="voucherCode" maxlength="50"
                               value="@Model.VoucherCode" placeholder="Nhập mã voucher"
                               autocomplete="off" autocapitalize="characters"
                               @(!Model.CurrentTable.OrderID.HasValue ? "disabled" : null) />
                        <button type="button" class="btn-apply-voucher" id="applyVoucherButton"
                                onclick="applyVoucher()"
                                @(!Model.CurrentTable.OrderID.HasValue ? "disabled" : null)>
                            Áp dụng
                        </button>
                    </div>
                </div>

                <button type="button" class="btn-clear-discount" id="clearDiscountButton"
                        onclick="clearOrderDiscount()"
                        @(string.Equals(Model.DiscountMode, "None", StringComparison.OrdinalIgnoreCase) ? "hidden" : null)>
                    <i class="bi bi-x-circle" aria-hidden="true"></i> Bỏ ưu đãi
                </button>
            </div>
        </div>


        <div class="notes-discount-section">

            <div class="notes-part">
                <label>Ghi chú:</label>
                <textarea class="form-control form-control-sm" placeholder="Ghi chú cho đơn hàng..." rows="2" id="orderNotes">@Model.Notes</textarea>
            </div>
        </div>
    }
    else
    {
        <div class="empty-state">
            <i class="bi bi-inbox"></i>
            <p>Vui lòng chọn bàn từ danh sách</p>
        </div>
    }
</div>
