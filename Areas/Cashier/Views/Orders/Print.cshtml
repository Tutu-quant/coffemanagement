@model Quản_lý_quán_cafe.Models.ViewModels.Order.OrderDetailViewModel

@{
    Layout = "~/Areas/Cashier/Views/Shared/_POSLayout.cshtml";
}

@section Head {
    <link rel="stylesheet" href="~/css/receipt.css" asp-append-version="true" />
    <style>
        html, body { 
            height: auto; 
            min-height: 100vh; 
            overflow: auto;
            background-color: #fafafa;
        }

        @@media print {
            html, body { 
                height: auto !important; 
                overflow: visible !important;
                background-color: #fff !important;
            }
            .container { 
                max-width: none; 
                padding: 0 !important;
                margin: 0 !important;
            }
        }
    </style>
}

<div class="receipt-page">
    <div class="receipt-actions no-print">
        <a class="btn btn-outline-secondary" href="@((ViewData["ReturnUrl"] as string) ?? Url.Action("Index", "POS", new { area = "Cashier" }))">
            <i class="bi bi-arrow-left"></i> Quay lại
        </a>
        <button type="button" class="btn btn-print" onclick="window.print()">
            <i class="bi bi-printer"></i> In hóa đơn
        </button>
    </div>

    @await Html.PartialAsync("~/Views/Shared/_Bill.cshtml", Model)
</div>

<script>
    window.addEventListener('load', function() {
        // Auto-print after 300ms if opened directly from POS
        // Uncomment if you want auto-print on page load
        // setTimeout(() => {
        //     window.print();
        // }, 300);
    });
</script>
