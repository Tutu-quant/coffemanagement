@model Quản_lý_quán_cafe.Models.ViewModels.Order.OrderDetailViewModel

@{
    Layout = "~/Areas/Cashier/Views/Shared/_POSLayout.cshtml";
}

@section Head {
    <style>
        html, body { height: auto; min-height: 100%; overflow: auto; }
        @@media print {
            html, body { height: auto !important; overflow: visible !important; }
            .container { max-width: none; padding: 0 !important; }
        }
    </style>
}

<div class="container" style="padding:20px 0;">
    <div class="d-print-none mb-3">
        <a class="btn btn-outline-secondary me-2" href="@((ViewData["ReturnUrl"] as string) ?? Url.Action("Index", "POS", new { area = "Cashier" }))">
            <i class="bi bi-arrow-left"></i> Quay lại
        </a>
        <button type="button" class="btn btn-primary" onclick="window.print()"><i class="bi bi-printer"></i> In hóa đơn</button>
    </div>

    <div class="print-area bg-white p-4">
        @await Html.PartialAsync("~/Views/Shared/_Bill.cshtml", Model)
    </div>
</div>

<script>
    window.addEventListener('load', function() {
        setTimeout(() => {
            window.print();
        }, 300);
    });
</script>
