@model Quản_lý_quán_cafe.Models.ViewModels.Order.OrderDetailViewModel

@{
    ViewData["Title"] = $"Chi tiết {Model.OrderCode}";
    Layout = "~/Areas/Cashier/Views/Shared/_CashierLayout.cshtml";
}

<div class="container-fluid py-3">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div>
            <h1 class="h3 mb-1">Chi tiết đơn hàng @Model.OrderCode</h1>
            <div class="text-muted">@Model.OrderDate.ToString("dd/MM/yyyy HH:mm")</div>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Quay lại</a>
            <a asp-action="Print" asp-route-id="@Model.OrderId"
               asp-route-returnUrl="@Url.Action("Details", "Orders", new { area = "Cashier", id = Model.OrderId })"
               target="_blank" class="btn btn-primary"><i class="bi bi-printer"></i> In hóa đơn</a>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-lg-4">
            <div class="card h-100"><div class="card-body">
                <h2 class="h5 mb-3"><i class="bi bi-receipt"></i> Đơn hàng</h2>
                <dl class="row mb-0">
                    <dt class="col-5">Trạng thái</dt><dd class="col-7 text-end"><span class="badge @Model.StatusBadgeClass">@Model.OrderStatus</span></dd>
                    <dt class="col-5">Bàn</dt><dd class="col-7 text-end">@(string.IsNullOrWhiteSpace(Model.TableNumber) ? "Mang đi" : Model.TableNumber)</dd>
                    <dt class="col-5">Sức chứa</dt><dd class="col-7 text-end">@(Model.TableCapacity?.ToString() ?? "-")</dd>
                </dl>
            </div></div>
        </div>
        <div class="col-lg-4">
            <div class="card h-100"><div class="card-body">
                <h2 class="h5 mb-3"><i class="bi bi-person"></i> Khách hàng</h2>
                <div class="fw-semibold">@(Model.CustomerName ?? "Khách lẻ")</div>
                <div class="text-muted">@(Model.CustomerPhone ?? "-")</div>
                @if (!string.IsNullOrWhiteSpace(Model.CustomerEmail))
                {
                    <a href="mailto:@Model.CustomerEmail">@Model.CustomerEmail</a>
                }
            </div></div>
        </div>
        <div class="col-lg-4">
            <div class="card h-100"><div class="card-body">
                <h2 class="h5 mb-3"><i class="bi bi-credit-card"></i> Thanh toán</h2>
                <dl class="row mb-0">
                    <dt class="col-6">Tạm tính</dt><dd class="col-6 text-end">@(Model.LoyaltySubtotalAmount > 0 ? Model.LoyaltySubtotalAmount.ToString("N0") : Model.Subtotal.ToString("N0"))đ</dd>
                    @if (Model.PointDiscountAmount > 0)
                    {
                        <dt class="col-6">Điểm (@Model.AppliedRewardPoints)</dt><dd class="col-6 text-end text-danger">-@Model.PointDiscountAmount.ToString("N0")đ</dd>
                    }
                    @if (Model.VoucherDiscountAmount > 0)
                    {
                        <dt class="col-6">Voucher @Model.AppliedVoucherCode</dt><dd class="col-6 text-end text-danger">-@Model.VoucherDiscountAmount.ToString("N0")đ</dd>
                    }
                    <dt class="col-6">Tổng tiền</dt><dd class="col-6 text-end fw-bold">@Model.TotalAmount.ToString("N0")đ</dd>
                    <dt class="col-6">Đã thanh toán</dt><dd class="col-6 text-end">@Model.PaidAmount.ToString("N0")đ</dd>
                    <dt class="col-6">Còn lại</dt><dd class="col-6 text-end">@Model.RemainingAmount.ToString("N0")đ</dd>
                    <dt class="col-6">Trạng thái</dt><dd class="col-6 text-end">@Model.PaymentStatus</dd>
                </dl>
            </div></div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header fw-semibold"><i class="bi bi-cup-hot"></i> Danh sách món</div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead><tr><th>Món</th><th class="text-end">Đơn giá</th><th class="text-center">SL</th><th class="text-end">Thành tiền</th><th>Ghi chú</th></tr></thead>
                <tbody>
                @if (Model.Items.Any())
                {
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td class="fw-semibold">@item.ProductName</td>
                            <td class="text-end">@item.UnitPrice.ToString("N0")đ</td>
                            <td class="text-center">@item.Quantity</td>
                            <td class="text-end fw-semibold">@item.TotalPrice.ToString("N0")đ</td>
                            <td>@(item.Notes ?? "-")</td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="5" class="text-center text-muted py-4">Đơn hàng chưa có món.</td></tr>
                }
                </tbody>
            </table>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.Notes))
    {
        <div class="alert alert-light border"><strong>Ghi chú:</strong> @Model.Notes</div>
    }
</div>
