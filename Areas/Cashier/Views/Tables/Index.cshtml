@model IEnumerable<Quản_lý_quán_cafe.Models.Entities.RestaurantTable>
@using TableStatuses = Quản_lý_quán_cafe.Models.Enums.TableStatus
@{
    ViewData["Title"] = "Quản lý bàn";
    Layout = "~/Areas/Cashier/Views/Shared/_CashierLayout.cshtml";
    var reservedTableIds = ViewBag.ReservedTableIds as HashSet<int> ?? new HashSet<int>();
}

<div class="cashier-dashboard">
    @if (TempData["SuccessMessage"] is not null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] is not null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Statistics Cards -->
    <div class="stats-grid">
        <div class="stat-card stat-card-empty">
            <div class="stat-icon">
                <i class="fas fa-chair"></i>
            </div>
            <div class="stat-content">
                <p class="stat-label">Bàn Trống</p>
                <div class="stat-value">@Model.Count(t => t.TableStatus == TableStatuses.Available && !reservedTableIds.Contains(t.TableID))</div>
                <p class="stat-desc">Sẵn sàng phục vụ</p>
            </div>
        </div>

        <div class="stat-card stat-card-serving">
            <div class="stat-icon">
                <i class="fas fa-utensils"></i>
            </div>
            <div class="stat-content">
                <p class="stat-label">Đang Sử Dụng</p>
                <div class="stat-value">@Model.Count(t => t.TableStatus == TableStatuses.Occupied)</div>
                <p class="stat-desc">Đang ăn</p>
            </div>
        </div>

        <div class="stat-card stat-card-pending">
            <div class="stat-icon">
                <i class="fas fa-credit-card"></i>
            </div>
            <div class="stat-content">
                <p class="stat-label">Chờ Thanh Toán</p>
                <div class="stat-value">@Model.Count(t => t.TableStatus == TableStatuses.WaitingPayment)</div>
                <p class="stat-desc">Chờ thanh toán</p>
            </div>
        </div>

        <div class="stat-card stat-card-reserved">
            <div class="stat-icon">
                <i class="fas fa-bookmark"></i>
            </div>
            <div class="stat-content">
                <p class="stat-label">Đã Đặt Trước</p>
                <div class="stat-value">@Model.Count(t => t.TableStatus == TableStatuses.Reserved || reservedTableIds.Contains(t.TableID))</div>
                <p class="stat-desc">Khách sắp tới</p>
            </div>
        </div>
    </div>

    <!-- Tables Grid -->
    <div>
        <div class="section-title">
            <h2>Sơ đồ bàn</h2>
            <span class="table-count">@Model.Count() bàn</span>
        </div>
        <div class="tables-grid">
            @foreach (var table in Model)
            {
                var displayStatus = reservedTableIds.Contains(table.TableID) ? TableStatuses.Reserved : table.TableStatus;
                var cardClass = displayStatus switch
                {
                    "Available" => "table-card-empty",
                    "Reserved" => "table-card-reserved",
                    "Occupied" => "table-card-serving",
                    "WaitingPayment" => "table-card-pendingpayment",
                    "Maintenance" => "table-card-maintenance",
                    _ => "table-card-empty"
                };

                <div class="table-card @cardClass">
                    <div class="table-header">
                        <h3 class="table-number">@table.TableNumber</h3>
                        <span class="table-capacity">@table.Capacity chỗ</span>
                    </div>

                    <div class="table-body">
                        <span class="status-indicator status-@(displayStatus.ToLower())">
                            @switch (displayStatus)
                            {
                                case "Available":
                                    <i class="fas fa-check-circle"></i>
                                    <text>Trống</text>
                                    break;
                                case "Reserved":
                                    <i class="fas fa-clock"></i>
                                    <text>Đã đặt</text>
                                    break;
                                case "Occupied":
                                    <i class="fas fa-utensils"></i>
                                    <text>Đang phục vụ</text>
                                    break;
                                case "WaitingPayment":
                                    <i class="fas fa-credit-card"></i>
                                    <text>Chờ TT</text>
                                    break;
                                case "Maintenance":
                                    <i class="fas fa-tools"></i>
                                    <text>Bảo trì</text>
                                    break;
                            }
                        </span>
                        <p class="table-location">
                            <i class="fas fa-map-marker-alt"></i> @table.Location
                        </p>
                    </div>

                    <div class="table-footer">
                        @if (reservedTableIds.Contains(table.TableID))
                        {
                            <button type="button" class="btn btn-sm btn-primary" onclick="location.href='@Url.Action("Index", "POS", new { area = "Cashier", tableId = table.TableID })'">
                                <i class="fas fa-cash-register"></i> Mở POS
                            </button>
                        }
                        else
                        {
                            <form asp-action="UpdateStatus" method="post" style="display: flex; gap: 8px; align-items: center;">
                                <input type="hidden" name="tableId" value="@table.TableID" />
                                <select name="status" class="form-select form-select-sm" style="flex: 1; border-color: #ccc;">
                                    @foreach (var status in TableStatuses.All.Where(status => status != TableStatuses.Reserved))
                                    {
                                        <option value="@status" selected="@(status == table.TableStatus)">@status</option>
                                    }
                                </select>
                                <button type="submit" class="btn btn-sm" style="background: var(--primary-color); color: white; border: none;">
                                    <i class="fas fa-save"></i>
                                </button>
                            </form>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>
}