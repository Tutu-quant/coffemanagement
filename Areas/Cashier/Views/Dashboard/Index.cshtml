@model Quản_lý_quán_cafe.Areas.Cashier.ViewModels.CashierDashboardViewModel

@{
    ViewData["Title"] = "Tổng quan";
    ViewData["PageTitle"] = "Tổng quan";
    ViewData["PageBreadcrumb"] = "<span class='breadcrumb-item'><i class='bi bi-speedometer2'></i> Tổng quan</span>";
}

<div class="page-header-cashier">
    <h1 class="page-title">📊 Tổng quan hôm nay</h1>
    <div>
        <span class="text-muted" id="current-time">@DateTime.Now.ToString("HH:mm:ss")</span>
    </div>
</div>

<!-- Stat Cards -->
<div class="stat-cards">
    <div class="stat-card">
        <div class="stat-card-content">
            <h3>Bàn đang hoạt động</h3>
            <p class="stat-card-value">@Model.ActiveTablesCount</p>
        </div>
        <div class="stat-card-icon">
            <i class="bi bi-door-open"></i>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-card-content">
            <h3>Đơn hôm nay</h3>
            <p class="stat-card-value">@Model.TodayOrdersCount</p>
        </div>
        <div class="stat-card-icon">
            <i class="bi bi-receipt"></i>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-card-content">
            <h3>Chờ thanh toán</h3>
            <p class="stat-card-value">@Model.WaitingPaymentCount</p>
        </div>
        <div class="stat-card-icon">
            <i class="bi bi-cash-coin"></i>
        </div>
    </div>

    <div class="stat-card">
        <div class="stat-card-content">
            <h3>Doanh thu hôm nay</h3>
            <p class="stat-card-value">@Model.TodayRevenue.ToString("N0")đ</p>
        </div>
        <div class="stat-card-icon">
            <i class="bi bi-graph-up"></i>
        </div>
    </div>
</div>

<!-- Quick billing -->
<div class="order-panel" style="margin-top: 2rem;">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h3 class="order-panel-title mb-0">
            <i class="bi bi-calculator"></i>
            Tính tiền nhanh
        </h3>
        <strong>Tạm tính: @Model.PendingPaymentTotal.ToString("N0")đ</strong>
    </div>
    @if (Model.PendingBills.Any())
    {
        <div class="order-list">
            @foreach (var bill in Model.PendingBills)
            {
                <div class="order-item d-flex align-items-center justify-content-between gap-3">
                    <div>
                        <div class="order-item-code">Bàn @bill.TableName · #@bill.OrderCode</div>
                        <div class="order-item-table">@bill.ItemCount món · vào lúc @bill.CreatedAt.ToString("HH:mm")</div>
                    </div>
                    <div class="d-flex align-items-center gap-3">
                        <strong class="order-item-amount">@bill.TotalAmount.ToString("N0")đ</strong>
                        <a asp-area="Cashier" asp-controller="POS" asp-action="Index" asp-route-tableId="@bill.TableID"
                           class="btn btn-success btn-sm">
                            <i class="bi bi-cash-coin"></i> Tính tiền
                        </a>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-muted text-center py-3">Không có hóa đơn đang chờ thanh toán.</div>
    }
</div>

<!-- Floor Map -->
<div class="floor-map">
    <h2 class="floor-map-title">📍 Sơ đồ bàn</h2>
    @Html.AntiForgeryToken()
    <div class="tables-grid">
        @foreach (var table in Model.Tables)
        {
            var statusClass = table.Status.ToLower() switch
            {
                "occupied" => "occupied",
                "waitingpayment" => "waiting",
                "reserved" => "reserved",
                _ => "empty"
            };
            <div class="table-item @statusClass" title="@table.StatusLabel" data-table-id="@table.TableID">
                <a href="~/Cashier/POS?tableId=@table.TableID" class="table-link">
                    <div class="table-name">
                        <i class="bi bi-table"></i> @table.TableName
                    </div>
                    <div class="table-info">
                        @if (table.Status == "Occupied" && table.GuestCount.HasValue)
                        {
                            <span>👥 @table.GuestCount khách</span>
                        }
                        else if (table.Status == "WaitingPayment")
                        {
                            <span style="color: #FF6B6B; font-weight: 600;">⏳ @table.TotalAmount?.ToString("N0")đ</span>
                        }
                        else
                        {
                            <span>Trống</span>
                        }
                    </div>
                    @if (!string.IsNullOrEmpty(table.OrderCode))
                    {
                        <div class="table-info" style="margin-top: 0.5rem;">
                            <span style="background: rgba(139, 69, 19, 0.1); padding: 0.25rem 0.5rem; border-radius: 4px; font-size: 11px;">
                                #@table.OrderCode
                            </span>
                        </div>
                    }
                </a>

                <div class="table-actions" style="margin-top:6px; display:flex; gap:6px; justify-content:center;">
                    <button type="button" class="btn btn-outline-secondary btn-sm p-1 rounded-circle" title="Available" onclick="changeTableStatus(@table.TableID, 'Available')">
                        <i class="bi bi-check-lg"></i>
                    </button>
                    <button type="button" class="btn btn-outline-secondary btn-sm p-1 rounded-circle" title="Occupy" onclick="changeTableStatus(@table.TableID, 'Occupied')">
                        <i class="bi bi-person-fill"></i>
                    </button>
                    <button type="button" class="btn btn-outline-secondary btn-sm p-1 rounded-circle" title="Waiting" onclick="changeTableStatus(@table.TableID, 'WaitingPayment')">
                        <i class="bi bi-hourglass-split"></i>
                    </button>
                    <button type="button" class="btn btn-outline-secondary btn-sm p-1 rounded-circle" title="Maintenance" onclick="changeTableStatus(@table.TableID, 'Maintenance')">
                        <i class="bi bi-tools"></i>
                    </button>
                </div>
            </div>
        }
    </div>
</div>

<!-- Recent Orders -->
@if (Model.RecentOrders.Any())
{
    <div class="order-panel" style="margin-top: 2rem;">
        <h3 class="order-panel-title">
            <i class="bi bi-clock-history"></i>
            Đơn gần đây
        </h3>
        <div class="order-list">
            @foreach (var order in Model.RecentOrders)
            {
                <a href="~/Cashier/POS?orderId=@order.OrderID" class="order-item">
                    <div class="order-item-code">
                        Order #@order.OrderCode
                    </div>
                    <div class="order-item-table">
                        📍 @order.TableName - @order.CreatedAt.ToString("HH:mm")
                    </div>
                    <div class="order-item-amount">
                        @order.TotalAmount.ToString("N0")đ (@order.ItemCount) món
                    </div>
                </a>
            }
        </div>
    </div>
}

@section Scripts {
    <script>
        // Update time every second
        setInterval(() => {
            const now = new Date();
            document.getElementById('current-time').textContent = now.toLocaleTimeString('vi-VN');
        }, 1000);

        // Auto-refresh dashboard every 30 seconds (realtime table status)
        setInterval(() => {
            location.reload();
        }, 30000);

        // change table status via AJAX (shared with POS)
        async function changeTableStatus(tableId, status) {
            const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
            const token = tokenInput ? tokenInput.value : null;
            const formData = new URLSearchParams();
            formData.append('tableId', tableId);
            formData.append('status', status);
            if (token) formData.append('__RequestVerificationToken', token);

            try {
                const res = await fetch('/Cashier/Tables/UpdateStatus', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8' },
                    body: formData.toString()
                });
                if (res.redirected) {
                    // On redirect, reload to show TempData messages
                    window.location.reload();
                    return;
                }
                if (!res.ok) {
                    const txt = await res.text();
                    alert('Không thể cập nhật trạng thái: ' + txt);
                    return;
                }
                // Update UI: quick visual change
                const el = document.querySelector(`.table-item[data-table-id="${tableId}"]`);
                if (el) {
                    el.classList.remove('empty','occupied','waiting','reserved','maintenance');
                    const st = status.toLowerCase();
                    const cls = st === 'waitingpayment' ? 'waiting' : (st === 'available' ? 'empty' : st);
                    el.classList.add(cls);
                }
            } catch (err) {
                console.error(err);
                alert('Lỗi khi cập nhật trạng thái');
            }
        }
    </script>
}
