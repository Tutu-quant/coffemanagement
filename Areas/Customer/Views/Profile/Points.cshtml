@model Quản_lý_quán_cafe.Models.Entities.Customer

@section Head {
    <link rel="stylesheet" href="~/css/customers.css" asp-append-version="true" />
}

@{
    ViewData["Title"] = "Điểm tích lũy";
    Layout = "_UnifiedLayout";
}

<div class="d-flex">
    <aside class="flex-shrink-0">
        @await Html.PartialAsync("_CustomerSidebar")
    </aside>

    <main class="flex-grow-1 px-4 py-3">
        <div class="page-header mb-4">
            <h4 class="m-0">Điểm tích lũy</h4>
        </div>

        <div class="card">
            <div class="card-body">
                <p><strong>Họ và tên:</strong> @Model.CustomerName</p>
                <p><strong>Điểm hiện có:</strong> @Model.RewardPoints</p>

                <hr />

                <p>Ví dụ hệ thống tích điểm: 1 điểm = 10.000đ. (Thông tin chi tiết do backend cung cấp)</p>

                <div class="mt-3">
                    <a asp-area="Customer" asp-controller="Profile" asp-action="Index" class="btn btn-secondary">Quay lại</a>
                </div>
            </div>
        </div>
    </main>
</div>