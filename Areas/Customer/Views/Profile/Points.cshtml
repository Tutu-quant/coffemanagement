@using Quản_lý_quán_cafe.Models
@using Quản_lý_quán_cafe.Models.ViewModels.Customer
@model CustomerPointsViewModel

@{
    ViewData["Title"] = "Điểm thưởng";
    ViewData["PageTitle"] = "Điểm thưởng";
    Layout = "_UnifiedLayout";
}

<div class="px-2 py-1">
    <div class="page-header d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div>
            <span class="text-uppercase small text-muted">Tài khoản thành viên</span>
            <h4 class="m-0">Điểm thưởng của bạn</h4>
        </div>
        <a asp-area="Customer" asp-controller="Profile" asp-action="Index" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left"></i> Hồ sơ
        </a>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-5 col-lg-4">
            <div class="card h-100 border-0 shadow-sm" style="background: linear-gradient(135deg, #4a2b1d, #7a4b31); color: #fff;">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <div class="small text-uppercase opacity-75">Số dư khả dụng</div>
                            <div class="display-5 fw-bold my-2">@Model.RewardPoints.ToString("N0")</div>
                            <div class="opacity-75">Tương đương @((Model.RewardPoints * 100m).ToString("N0"))đ</div>
                        </div>
                        <i class="bi bi-stars fs-2"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-7 col-lg-8">
            <div class="card h-100 shadow-sm">
                <div class="card-body p-4 d-flex flex-column justify-content-center">
                    <h5 class="mb-2">Cách sử dụng điểm</h5>
                    <p class="text-muted mb-1">Khi thanh toán, chọn dùng điểm để hệ thống tự áp dụng toàn bộ số điểm khả dụng.</p>
                    <p class="text-muted mb-0">Nếu số điểm vượt quá giá trị đơn, hệ thống chỉ trừ số điểm cần thiết và giữ lại phần dư.</p>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-white py-3">
            <h5 class="mb-0"><i class="bi bi-clock-history me-2"></i>Lịch sử điểm</h5>
        </div>
        @if (Model.History.Count == 0)
        {
            <div class="card-body text-center py-5 text-muted">
                <i class="bi bi-stars d-block fs-1 mb-2"></i>
                Chưa có giao dịch điểm nào.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Thời gian</th>
                            <th>Nội dung</th>
                            <th>Đơn hàng</th>
                            <th class="text-end">Số dư</th>
                            <th class="text-end">Thay đổi</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model.History)
                    {
                        var isCredit = item.Points >= 0;
                        <tr>
                            <td class="text-nowrap">@BusinessClock.FromUtc(item.TransactionDate).ToString("HH:mm · dd/MM/yyyy")</td>
                            <td>
                                <strong>@TransactionLabel(item.TransactionType)</strong>
                                @if (!string.IsNullOrWhiteSpace(item.Description))
                                {
                                    <div class="small text-muted">@item.Description</div>
                                }
                            </td>
                            <td>
                                @if (item.OrderId.HasValue
                                    && string.Equals(item.TransactionType, "Earn", StringComparison.OrdinalIgnoreCase))
                                {
                                    <a asp-area="Customer" asp-controller="Orders" asp-action="Details" asp-route-id="@item.OrderId">#@item.OrderId</a>
                                }
                                else if (item.OrderId.HasValue)
                                {
                                    <span>#@item.OrderId</span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td class="text-end">@item.BalanceAfter.ToString("N0")</td>
                            <td class="text-end fw-bold @(isCredit ? "text-success" : "text-danger")">
                                @(isCredit ? "+" : string.Empty)@item.Points.ToString("N0")
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@functions {
    private static string TransactionLabel(string? type) => type?.Trim().ToLowerInvariant() switch
    {
        "earned" or "earn" => "Cộng điểm từ hóa đơn",
        "redeemed" or "redeem" => "Dùng điểm thanh toán",
        "gift" or "granted" or "grant" => "Quản trị viên tặng điểm",
        "refund" or "refunded" => "Hoàn điểm",
        _ => string.IsNullOrWhiteSpace(type) ? "Điều chỉnh điểm" : type
    };
}
