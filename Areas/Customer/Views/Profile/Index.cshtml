@model Quản_lý_quán_cafe.Models.Entities.Customer

@section Head {
    <link rel="stylesheet" href="~/css/customers.css" asp-append-version="true" />
}

@{
    ViewData["Title"] = "Thông tin cá nhân";
    Layout = "_UnifiedLayout";
}

<div class="px-2 py-1">
        <div class="page-header d-flex justify-content-between align-items-center mb-4">
            <h4 class="m-0">Thông tin cá nhân</h4>
            <div class="d-flex gap-2">
                <a asp-area="Customer" asp-controller="Profile" asp-action="Points" class="btn btn-outline-primary btn-sm">
                    <i class="bi bi-stars"></i> Lịch sử điểm
                </a>
                <a asp-area="Customer" asp-controller="Profile" asp-action="Edit" class="btn btn-primary btn-sm">Chỉnh sửa</a>
            </div>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">@TempData["SuccessMessage"]</div>
        }

        <div class="row g-3 mb-3">
            <div class="col-md-5 col-lg-4">
                <div class="card h-100 border-0" style="background: linear-gradient(135deg, #5b3524, #8b5e3c); color: #fff;">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <div class="small text-uppercase opacity-75">Điểm thưởng hiện có</div>
                                <div class="display-6 fw-bold mt-1">@Model.RewardPoints.ToString("N0")</div>
                                <div class="small opacity-75">1 điểm = 100đ</div>
                            </div>
                            <i class="bi bi-stars fs-2"></i>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-7 col-lg-8">
                <div class="card h-100">
                    <div class="card-body d-flex flex-column justify-content-center">
                        <strong>Tích điểm cùng BrewPoint</strong>
                        <span class="text-muted mt-1">Mỗi 10.000đ trên hóa đơn trước giảm giá được cộng 1 điểm sau khi đơn hoàn tất.</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <p class="mb-1"><strong>Họ và tên</strong></p>
                        <p class="text-muted">@Model.CustomerName</p>
                    </div>
                    <div class="col-md-6">
                        <p class="mb-1"><strong>Email</strong></p>
                        <p class="text-muted">@Model.Email</p>
                    </div>
                    <div class="col-md-6">
                        <p class="mb-1"><strong>Điện thoại</strong></p>
                        <p class="text-muted">@Model.Phone</p>
                    </div>
                    <div class="col-md-6">
                        <p class="mb-1"><strong>Địa chỉ</strong></p>
                        <p class="text-muted">@Model.Address</p>
                    </div>
                </div>
            </div>
        </div>
</div>
