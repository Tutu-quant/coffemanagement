@model Quản_lý_quán_cafe.Areas.Customer.ViewModels.OrderMenuViewModel

@{
    Layout = "~/Views/Shared/_UnifiedLayout.cshtml";
    ViewData["Title"] = "Đặt món";
    ViewData["PageTitle"] = "Menu gọi món";
    var initialCartJson = "[]";
    try
    {
        var parsedCart = System.Text.Json.JsonSerializer.Deserialize<System.Text.Json.JsonElement>(Model.CartJson ?? "[]");
        initialCartJson = System.Text.Json.JsonSerializer.Serialize(parsedCart);
    }
    catch (System.Text.Json.JsonException)
    {
        initialCartJson = "[]";
    }
}

@section Head {
    <link rel="stylesheet" href="~/css/customer-order.css" asp-append-version="true" />
}

<div class="order-page">
    <section class="menu-section">
        <div class="menu-hero">
            <div><span>BREWPOINT MENU</span><h2>Hôm nay bạn muốn uống gì?</h2><p>Chọn món, kiểm tra giỏ hàng và gửi đơn trực tiếp tới quầy.</p></div>
            <div class="menu-search"><i class="bi bi-search"></i><input id="menuSearch" placeholder="Tìm cà phê, trà, bánh..." /></div>
        </div>

        <div class="category-tabs">
            <button class="active" data-category="all">Tất cả</button>
            @foreach (var category in Model.Categories)
            {
                <button data-category="@category.Name.ToLowerInvariant().Replace(" ", "-")">@category.Name</button>
            }
        </div>

        @foreach (var category in Model.Categories)
        {
            var categoryKey = category.Name.ToLowerInvariant().Replace(" ", "-");
            <div class="menu-category" data-category="@categoryKey">
                <div class="category-heading"><h3>@category.Name</h3><span>@category.Products.Count món</span></div>
                <div class="product-grid">
                    @foreach (var product in category.Products)
                    {
                        <article class="menu-product"
                                 data-name="@product.Name.ToLowerInvariant()"
                                 data-category="@categoryKey"
                                 data-search="@($"{product.Name.ToLowerInvariant()} {product.Description.ToLowerInvariant()}")">
                            <div class="product-image">
                                @if (!string.IsNullOrWhiteSpace(product.ImageUrl))
                                {
                                    <img src="@product.ImageUrl" alt="@product.Name" />
                                }
                                else
                                {
                                    <i class="bi bi-cup-hot"></i>
                                }
                                <span>Còn @product.AvailableQuantity</span>
                            </div>
                            <div class="product-body">
                                <h4>@product.Name</h4>
                                <p>@product.Description</p>
                                <div><strong>@product.Price.ToString("N0")đ</strong>
                                    <button type="button" class="add-product"
                                            data-id="@product.ProductId"
                                            data-name="@product.Name"
                                            data-price="@product.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                            data-stock="@product.AvailableQuantity">
                                        <i class="bi bi-plus-lg"></i>
                                    </button>
                                </div>
                            </div>
                        </article>
                    }
                </div>
            </div>
        }
    </section>

    <aside class="cart-panel">
        <div class="cart-title"><div><span>ĐƠN CỦA BẠN</span><h3>Giỏ hàng</h3></div><span id="cartCount">0 món</span></div>
        <div id="cartItems" class="cart-items"><div class="empty-cart"><i class="bi bi-bag"></i><p>Chưa có món nào</p></div></div>
        <form asp-action="SubmitOrder" method="post" id="placeOrderForm">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="All" class="text-danger validation-summary"></div>
            <input asp-for="CartJson" type="hidden" id="cartJson" />
            <label asp-for="TableId">Bàn phục vụ</label>
            <select asp-for="TableId" asp-items="Model.Tables" class="form-select">
                <option value="0">-- Chọn bàn --</option>
            </select>
            <span asp-validation-for="TableId" class="text-danger"></span>
            <label asp-for="Notes">Ghi chú chung</label>
            <textarea asp-for="Notes" class="form-control" rows="2" maxlength="1000" placeholder="Ít đá, giao món cùng lúc..."></textarea>
            <div class="cart-total"><span>Tổng cộng</span><strong id="cartTotal">0đ</strong></div>
            <button type="submit" class="place-order-btn"><i class="bi bi-send"></i> Gửi đơn tới quầy</button>
        </form>
    </aside>
</div>

@section Scripts {
<script type="application/json" id="initialCartData">@Html.Raw(initialCartJson)</script>
<script>
    const initialCart = JSON.parse(document.getElementById('initialCartData')?.textContent || '[]');
    const cart = new Map();
    const money = value => new Intl.NumberFormat('vi-VN').format(value || 0) + 'đ';

    function createCartItem(button) {
        return {
            productId: Number(button.dataset.id),
            name: button.dataset.name || 'Sản phẩm',
            price: Number(button.dataset.price) || 0,
            quantity: 0,
            stock: Number(button.dataset.stock) || 0,
            notes: ''
        };
    }

    function addProduct(button) {
        const id = Number(button.dataset.id);
        const existing = cart.get(id) || createCartItem(button);
        if (existing.quantity >= Number(button.dataset.stock)) {
            alert('Sản phẩm đã đạt số lượng tồn kho.');
            return;
        }

        existing.quantity += 1;
        cart.set(id, existing);
        window.BrewPointRealtime?.markDirty();
        renderCart();
    }

    function attachAddHandlers() {
        document.querySelectorAll('.add-product').forEach(button => {
            button.onclick = (event) => {
                event.preventDefault();
                event.stopPropagation();
                addProduct(button);
            };
        });
    }

    function changeQuantity(id, change) {
        const item = cart.get(id);
        if (!item) return;
        item.quantity += change;
        if (item.quantity <= 0) cart.delete(id);
        else if (item.quantity > item.stock) item.quantity = item.stock;
        window.BrewPointRealtime?.markDirty();
        renderCart();
    }

    function updateNotes(id, value) {
        const item = cart.get(id);
        if (item) item.notes = String(value || '').slice(0, 500);
        window.BrewPointRealtime?.markDirty();
        syncCart();
    }

    function renderCart() {
        const container = document.getElementById('cartItems');
        const items = [...cart.values()];
        container.innerHTML = items.length === 0
            ? '<div class="empty-cart"><i class="bi bi-bag"></i><p>Chưa có món nào</p></div>'
            : items.map(item => `<div class="cart-item">
                <div class="cart-item-head"><strong>${escapeHtml(item.name)}</strong><button type="button" onclick="changeQuantity(${item.productId}, -${item.quantity})"><i class="bi bi-x"></i></button></div>
                <div class="cart-item-row"><span>${money(item.price)}</span><div class="quantity-control"><button type="button" onclick="changeQuantity(${item.productId},-1)">−</button><b>${item.quantity}</b><button type="button" onclick="changeQuantity(${item.productId},1)">+</button></div></div>
                <input value="${escapeHtml(item.notes || '')}" maxlength="500" onchange="updateNotes(${item.productId},this.value)" placeholder="Ghi chú món..." />
            </div>`).join('');
        document.getElementById('cartCount').textContent = `${items.reduce((sum, item) => sum + item.quantity, 0)} món`;
        document.getElementById('cartTotal').textContent = money(items.reduce((sum, item) => sum + item.price * item.quantity, 0));
        syncCart();
    }

    function syncCart() {
        const cartJson = document.getElementById('cartJson');
        if (cartJson) {
            cartJson.value = JSON.stringify([...cart.values()].map(item => ({
                productId: item.productId, quantity: item.quantity, notes: item.notes
            })));
        }
    }

    function escapeHtml(value) {
        const element = document.createElement('div');
        element.textContent = value ?? '';
        return element.innerHTML;
    }

    function initializeOrderPage() {
        if (Array.isArray(initialCart)) {
            initialCart.forEach(rawItem => {
                const id = Number(rawItem.productId ?? rawItem.ProductId);
                const button = document.querySelector(`.add-product[data-id="${id}"]`);
                if (!button) return;
                const item = createCartItem(button);
                item.quantity = Math.min(item.stock, Math.max(0, Number(rawItem.quantity ?? rawItem.Quantity) || 0));
                item.notes = String(rawItem.notes ?? rawItem.Notes ?? '').slice(0, 500);
                if (item.quantity > 0) cart.set(id, item);
            });
            if (cart.size > 0) window.BrewPointRealtime?.markDirty();
        }
        let activeCategory = 'all';
        let searchQuery = '';

        function applyFilters() {
            const query = searchQuery.trim().toLowerCase();

            document.querySelectorAll('.menu-category').forEach(section => {
                const products = section.querySelectorAll('.menu-product');
                let hasVisibleProducts = false;

                products.forEach(product => {
                    const productName = (product.dataset.name || '').toLowerCase();
                    const searchText = (product.dataset.search || '').toLowerCase();
                    const productCategory = product.dataset.category || '';

                    const matchesCategory =
                        activeCategory === 'all' ||
                        productCategory === activeCategory;

                    const matchesSearch =
                        query === '' ||
                        productName.includes(query) ||
                        searchText.includes(query);

                    const shouldShow = matchesCategory && matchesSearch;
                    product.hidden = !shouldShow;

                    if (shouldShow) {
                        hasVisibleProducts = true;
                    }
                });

                if (query !== '') {
                    section.hidden = !hasVisibleProducts;
                }
                else {
                    section.hidden =
                        activeCategory !== 'all' &&
                        section.dataset.category !== activeCategory;
                }
            });
        }

        document.querySelectorAll('.category-tabs button').forEach(button => {
            button.onclick = () => {
                document.querySelectorAll('.category-tabs button').forEach(x => x.classList.remove('active'));
                button.classList.add('active');
                activeCategory = button.dataset.category || 'all';
                applyFilters();
            };
        });

        const searchInput = document.getElementById('menuSearch');
        if (searchInput) {
            searchInput.addEventListener('input', event => {
                searchQuery = event.target.value.trim().toLowerCase();
                applyFilters();
            });
        }

        const placeOrderForm = document.getElementById('placeOrderForm');
        if (placeOrderForm) {
            placeOrderForm.addEventListener('submit', event => {
                syncCart();
                if (cart.size === 0) {
                    event.preventDefault();
                    alert('Vui lòng chọn ít nhất một món.');
                }
            });
        }

        attachAddHandlers();
        renderCart();
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initializeOrderPage);
    } else {
        initializeOrderPage();
    }
</script>
}
