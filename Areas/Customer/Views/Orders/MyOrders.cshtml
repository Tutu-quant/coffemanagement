@using Microsoft.EntityFrameworkCore
@model List<Quản_lý_quán_cafe.Models.Entities.Order>

@{
    ViewData["Title"] = "Đơn của tôi";
    Layout = "_UnifiedLayout";

    // Get reservations from ViewBag
    var reservations = ViewBag.Reservations as List<Quản_lý_quán_cafe.Models.Entities.Reservation> ?? new();

    // Tính toán thống kê cho Order
    var totalOrders = Model?.Count ?? 0;
    var completedOrders = Model?.Count(o => o.OrderStatus.ToLower() == "completed") ?? 0;
    var pendingOrders = Model?.Count(o => o.OrderStatus.ToLower() == "pending") ?? 0;
    var cancelledOrders = Model?.Count(o => o.OrderStatus.ToLower() == "cancelled") ?? 0;

    // Tính toán thống kê cho Reservation
    var totalReservations = reservations?.Count ?? 0;
    var confirmedReservations = reservations?.Count(r => r.ReservationStatus.ToLower() == "confirmed") ?? 0;
    var pendingReservations = reservations?.Count(r => r.ReservationStatus.ToLower() == "pending") ?? 0;
    var cancelledReservations = reservations?.Count(r => r.ReservationStatus.ToLower() == "cancelled") ?? 0;

    var selectedTab = Context.Request.Query["tab"].ToString();
    if (string.IsNullOrEmpty(selectedTab)) selectedTab = "orders";
}

<style>
    /* ===== MAIN LAYOUT ===== */
    .my-orders-container {
        display: flex;
        gap: 20px;
    }

    /* ===== HEADER & TITLE ===== */
    .history-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        margin-bottom: 30px;
        padding: 24px;
        border-radius: 18px;
        background: linear-gradient(135deg, #5D4037, #8B6F47);
        color: #fff;
    }

    .history-header > div {
        flex: 1;
    }

    .history-header span {
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 1.5px;
        color: #e6b98c;
        display: block;
        margin-bottom: 8px;
    }

    .history-header h2 {
        color: #fff;
        font-size: 24px;
        margin: 4px 0 8px 0;
    }

    .history-header p {
        margin: 0;
        opacity: 0.72;
        font-size: 14px;
    }

    .header-actions {
        display: flex;
        gap: 10px;
        align-items: center;
    }

    .new-order-btn {
        padding: 10px 15px;
        background: rgba(255,255,255,0.2);
        color: white;
        border: 1px solid rgba(255,255,255,0.3);
        border-radius: 8px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-weight: 600;
        transition: all 0.3s ease;
        font-size: 14px;
    }

    .new-order-btn:hover {
        background: rgba(255,255,255,0.3);
        color: white;
        text-decoration: none;
    }

    /* ===== TAB NAVIGATION ===== */
    .tab-navigation {
        display: flex;
        gap: 0;
        margin-bottom: 30px;
        border-bottom: 2px solid #E8E6E1;
        background: #fff;
        border-radius: 16px 16px 0 0;
        overflow: hidden;
    }

    .tab-item {
        flex: 1;
        padding: 16px 20px;
        text-decoration: none;
        color: #666;
        font-weight: 600;
        border-bottom: 3px solid transparent;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        text-align: center;
    }

    .tab-item:hover {
        color: #8B6F47;
        background: #F9F8F6;
    }

    .tab-item.active {
        color: #8B6F47;
        border-bottom-color: #8B6F47;
    }

    /* ===== STATISTICS CARDS ===== */
    .statistics-section {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 16px;
        margin-bottom: 30px;
    }

    .stat-card {
        background: #fff;
        border: 1px solid #E8E6E1;
        border-radius: 16px;
        padding: 20px;
        text-align: center;
        transition: all 0.3s ease;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
    }

    .stat-card:hover {
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
        transform: translateY(-4px);
    }

    .stat-label {
        font-size: 12px;
        font-weight: 700;
        color: #999;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 8px;
        display: block;
    }

    .stat-value {
        font-size: 32px;
        font-weight: 800;
        color: #8B6F47;
    }

    /* ===== FILTER & SEARCH ===== */
    .filter-section {
        background: #fff;
        border: 1px solid #E8E6E1;
        border-radius: 16px;
        padding: 20px;
        margin-bottom: 30px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
    }

    .filter-row {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: 12px;
        align-items: flex-end;
    }

    .filter-group {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .filter-group label {
        font-size: 12px;
        font-weight: 700;
        color: #3D2C27;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .filter-group input,
    .filter-group select {
        padding: 10px 12px;
        border: 1px solid #E8E6E1;
        border-radius: 8px;
        font-size: 13px;
        font-family: inherit;
        transition: all 0.3s ease;
    }

    .filter-group input:focus,
    .filter-group select:focus {
        outline: none;
        border-color: #8B6F47;
        box-shadow: 0 0 0 3px rgba(139, 111, 71, 0.1);
    }

    .filter-buttons {
        display: flex;
        gap: 10px;
    }

    .btn-filter,
    .btn-reset {
        padding: 10px 20px;
        border: none;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        font-size: 13px;
    }

    .btn-filter {
        background: #8B6F47;
        color: white;
        flex: 1;
    }

    .btn-filter:hover {
        background: #5D4037;
    }

    .btn-reset {
        background: #F5F2E8;
        color: #3D2C27;
        flex: 1;
    }

    .btn-reset:hover {
        background: #E8E6E1;
    }

    /* ===== STATUS TABS ===== */
    .status-tabs {
        display: flex;
        gap: 8px;
        margin-bottom: 30px;
        flex-wrap: wrap;
    }

    .tab-pill {
        padding: 8px 16px;
        border: 2px solid #E8E6E1;
        background: #fff;
        border-radius: 20px;
        cursor: pointer;
        font-size: 13px;
        font-weight: 600;
        color: #3D2C27;
        transition: all 0.3s ease;
        text-decoration: none;
    }

    .tab-pill:hover {
        border-color: #8B6F47;
        color: #8B6F47;
    }

    .tab-pill.active {
        background: #8B6F47;
        color: white;
        border-color: #8B6F47;
    }

    /* ===== ORDERS/RESERVATIONS CONTAINER ===== */
    .items-container {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(380px, 1fr));
        gap: 20px;
        margin-bottom: 40px;
    }

    .customer-item {
        background: #fff;
        border: 1px solid #E8E6E1;
        border-radius: 16px;
        padding: 20px;
        transition: all 0.3s ease;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
    }

    .customer-item:hover {
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
        transform: translateY(-4px);
    }

    .item-header-section {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 16px;
        padding-bottom: 16px;
        border-bottom: 2px solid #F5F2E8;
    }

    .item-id-section {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .item-id {
        font-size: 12px;
        font-weight: 800;
        color: #8B6F47;
        letter-spacing: 0.5px;
        text-transform: uppercase;
    }

    .item-title {
        font-size: 18px;
        font-weight: 700;
        color: #3D2C27;
    }

    .item-time {
        font-size: 11px;
        color: #999;
    }

    .status-badge {
        display: inline-block;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .status-pending {
        background: #FFF3E0;
        color: #E65100;
    }

    .status-completed,
    .status-confirmed {
        background: #E8F5E9;
        color: #2E7D32;
    }

    .status-cancelled {
        background: #FFEBEE;
        color: #C62828;
    }

    .item-details-section {
        margin-bottom: 16px;
    }

    .item-detail {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 0;
        border-bottom: 1px solid #F5F2E8;
    }

    .item-detail:last-child {
        border-bottom: none;
    }

    .detail-label {
        font-size: 13px;
        color: #666;
    }

    .detail-value {
        font-weight: 600;
        color: #3D2C27;
    }

    .no-items-message {
        text-align: center;
        padding: 20px;
        color: #999;
        font-style: italic;
        background: #F9F8F6;
        border-radius: 8px;
    }

    .item-note {
        background: #FFF8E1;
        border-left: 4px solid #FBC02D;
        padding: 12px;
        border-radius: 4px;
        font-size: 12px;
        color: #5D4037;
        margin-bottom: 16px;
        display: flex;
        gap: 8px;
        align-items: flex-start;
    }

    .item-note i {
        flex-shrink: 0;
        margin-top: 2px;
    }

    .item-footer-actions {
        display: flex;
        gap: 8px;
        margin-top: 16px;
        padding-top: 16px;
        border-top: 2px solid #F5F2E8;
    }

    .btn-action {
        flex: 1;
        padding: 10px 12px;
        border: 1px solid #E8E6E1;
        background: #fff;
        color: #3D2C27;
        border-radius: 8px;
        cursor: pointer;
        font-weight: 600;
        font-size: 12px;
        transition: all 0.3s ease;
        text-decoration: none;
        text-align: center;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
    }

    .btn-action:hover {
        border-color: #8B6F47;
        color: #8B6F47;
        text-decoration: none;
    }

    .btn-action.btn-primary {
        background: #8B6F47;
        color: white;
        border-color: #8B6F47;
    }

    .btn-action.btn-primary:hover {
        background: #5D4037;
        border-color: #5D4037;
        color: white;
    }

    .empty-state {
        text-align: center;
        padding: 80px 20px;
        background: linear-gradient(135deg, #F5F2E8, #FEFDFB);
        border: 2px dashed #E8E6E1;
        border-radius: 16px;
        color: #8f827a;
    }

    .empty-state i {
        font-size: 48px;
        display: block;
        margin-bottom: 16px;
        color: #D9D0C1;
    }

    .empty-state h3 {
        font-size: 18px;
        margin: 0 0 12px 0;
        color: #3D2C27;
    }

    .empty-state p {
        font-size: 14px;
        margin: 0 0 16px 0;
        color: #999;
    }

    .empty-state a {
        display: inline-block;
        padding: 10px 20px;
        background: #8B6F47;
        color: white;
        text-decoration: none;
        border-radius: 8px;
        font-weight: 600;
        transition: all 0.3s ease;
    }

    .empty-state a:hover {
        background: #5D4037;
        text-decoration: none;
    }

    .tab-content {
        display: none;
    }

    .tab-content.active {
        display: block;
    }

    /* ===== RESPONSIVE ===== */
    @@media (max-width: 1024px) {
        .items-container {
            grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        }
    }

    @@media (max-width: 768px) {
        .items-container {
            grid-template-columns: 1fr;
        }

        .statistics-section {
            grid-template-columns: repeat(2, 1fr);
        }

        .filter-row {
            grid-template-columns: 1fr;
        }

        .filter-buttons {
            flex-direction: column;
        }

        .history-header {
            flex-direction: column;
            gap: 16px;
        }

        .header-actions {
            flex-direction: column;
            width: 100%;
        }

        .new-order-btn {
            width: 100%;
            justify-content: center;
        }

        .tab-navigation {
            flex-direction: column;
        }

        .tab-item {
            border-bottom: none;
            border-left: 3px solid transparent;
        }

        .tab-item.active {
            border-left-color: #8B6F47;
            border-bottom: none;
        }

        .status-tabs {
            justify-content: flex-start;
            overflow-x: auto;
            padding-bottom: 8px;
        }

        .tab-pill {
            white-space: nowrap;
        }
    }

    @@media (max-width: 480px) {
        .statistics-section {
            grid-template-columns: 1fr;
        }

        .item-footer-actions {
            flex-direction: column;
        }

        .btn-action {
            padding: 12px;
        }
    }
</style>

<!-- HEADER SECTION -->
        <div class="history-header">
            <div>
                <span>QUẢN LÝ</span>
                <h2>Đơn của tôi</h2>
                <p>Theo dõi lịch sử gọi món và đặt bàn của bạn</p>
            </div>
            <div class="header-actions">
                <a asp-area="Customer" asp-controller="Orders" asp-action="Index" class="new-order-btn">
                    <i class="bi bi-plus-lg"></i> Đặt món
                </a>
                <a asp-area="Customer" asp-controller="Reservations" asp-action="Create" class="new-order-btn">
                    <i class="bi bi-calendar-plus"></i> Đặt bàn
                </a>
            </div>
        </div>

        <!-- TAB NAVIGATION -->
        <div class="tab-navigation">
            <a href="?tab=orders" class="tab-item @(selectedTab == "orders" || selectedTab == "" ? "active" : "")" data-tab="orders">
                <i class="bi bi-receipt"></i>
                Lịch sử gọi món
            </a>
            <a href="?tab=reservations" class="tab-item @(selectedTab == "reservations" ? "active" : "")" data-tab="reservations">
                <i class="bi bi-calendar-event"></i>
                Lịch sử đặt bàn
            </a>
        </div>

        <!-- ORDERS TAB CONTENT -->
        <div class="tab-content @(selectedTab == "orders" || selectedTab == "" ? "active" : "")" id="orders-tab">
            @if (Model != null && Model.Count > 0)
            {
                <!-- STATISTICS SECTION -->
                <div class="statistics-section">
                    <div class="stat-card">
                        <span class="stat-label">Tổng lượt đặt</span>
                        <span class="stat-value">@totalOrders</span>
                    </div>
                    <div class="stat-card">
                        <span class="stat-label">Đã hoàn thành</span>
                        <span class="stat-value">@completedOrders</span>
                    </div>
                    <div class="stat-card">
                        <span class="stat-label">Đang chờ</span>
                        <span class="stat-value">@pendingOrders</span>
                    </div>
                    <div class="stat-card">
                        <span class="stat-label">Đã hủy</span>
                        <span class="stat-value">@cancelledOrders</span>
                    </div>
                </div>

                <!-- ORDERS CONTAINER -->
                <div class="items-container">
                    @foreach (var order in Model)
                    {
                        <article class="customer-item" data-status="@order.OrderStatus.ToLower()">
                            <!-- Header Section -->
                            <div class="item-header-section">
                                <div class="item-id-section">
                                    <span class="item-id">Đơn #@order.OrderID</span>
                                    <span class="item-title">@(order.Table?.TableNumber ?? "Mang đi")</span>
                                    <span class="item-time">@order.OrderDate.ToLocalTime().ToString("HH:mm · dd/MM/yyyy")</span>
                                </div>
                                <span class="status-badge status-@order.OrderStatus.ToLowerInvariant()">
                                    @if (order.OrderStatus.ToLower() == "pending") { <span>Đang chờ</span> }
                                    else if (order.OrderStatus.ToLower() == "completed") { <span>Đã hoàn thành</span> }
                                    else if (order.OrderStatus.ToLower() == "cancelled") { <span>Đã hủy</span> }
                                    else { <span>@order.OrderStatus</span> }
                                </span>
                            </div>

                            <!-- Items Section -->
                            <div class="item-details-section">
                                @if (order.OrderDetails != null && order.OrderDetails.Count > 0)
                                {
                                    @foreach (var item in order.OrderDetails.Take(3))
                                    {
                                        <div class="item-detail">
                                            <span class="detail-label">@item.Quantity×  @(item.Product?.ProductName ?? "Sản phẩm")</span>
                                            <span class="detail-value">@item.Subtotal.ToString("N0")đ</span>
                                        </div>
                                    }
                                    @if (order.OrderDetails.Count > 3)
                                    {
                                        <div class="item-detail">
                                            <span class="detail-label"><em>+@(order.OrderDetails.Count - 3) mục khác...</em></span>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="no-items-message">Không có chi tiết đơn hàng</div>
                                }
                            </div>

                            <!-- Footer Section -->
                            <div class="item-footer-actions">
                                <a href="@Url.Action("Details", new { id = order.OrderID })" class="btn-action btn-primary">
                                    <i class="bi bi-eye"></i> Xem chi tiết
                                </a>
                            </div>
                        </article>
                    }
                </div>
            }
            else
            {
                <div class="empty-state">
                    <i class="bi bi-receipt"></i>
                    <h3>Chưa có đơn hàng nào</h3>
                    <p>Bạn chưa đặt bất kỳ đơn hàng nào. Hãy khám phá menu của chúng tôi!</p>
                    <a asp-action="Index">Bắt đầu đặt món</a>
                </div>
            }
        </div>

        <!-- RESERVATIONS TAB CONTENT -->
        <div class="tab-content @(selectedTab == "reservations" ? "active" : "")" id="reservations-tab">
            @if (reservations != null && reservations.Count > 0)
            {
                <!-- STATISTICS SECTION -->
                <div class="statistics-section">
                    <div class="stat-card">
                        <span class="stat-label">Tổng lượt đặt</span>
                        <span class="stat-value">@totalReservations</span>
                    </div>
                    <div class="stat-card">
                        <span class="stat-label">Đã xác nhận</span>
                        <span class="stat-value">@confirmedReservations</span>
                    </div>
                    <div class="stat-card">
                        <span class="stat-label">Đang chờ</span>
                        <span class="stat-value">@pendingReservations</span>
                    </div>
                    <div class="stat-card">
                        <span class="stat-label">Đã hủy</span>
                        <span class="stat-value">@cancelledReservations</span>
                    </div>
                </div>

                <!-- RESERVATIONS CONTAINER -->
                <div class="items-container">
                    @foreach (var reservation in reservations)
                    {
                        <article class="customer-item" data-status="@reservation.ReservationStatus.ToLower()">
                            <!-- Header Section -->
                            <div class="item-header-section">
                                <div class="item-id-section">
                                    <span class="item-id">Đặt bàn #@reservation.ReservationID</span>
                                    <span class="item-title">Bàn @(reservation.Table?.TableNumber ?? "N/A")</span>
                                    <span class="item-time">@reservation.ReservationDate.ToString("HH:mm · dd/MM/yyyy")</span>
                                </div>
                                <span class="status-badge status-@reservation.ReservationStatus.ToLowerInvariant()">
                                    @if (reservation.ReservationStatus.ToLower() == "pending") { <span>Đang chờ</span> }
                                    else if (reservation.ReservationStatus.ToLower() == "confirmed") { <span>Đã xác nhận</span> }
                                    else if (reservation.ReservationStatus.ToLower() == "cancelled") { <span>Đã hủy</span> }
                                    else { <span>@reservation.ReservationStatus</span> }
                                </span>
                            </div>

                            <!-- Details Section -->
                            <div class="item-details-section">
                                <div class="item-detail">
                                    <span class="detail-label">Số lượng khách</span>
                                    <span class="detail-value">@reservation.NumberOfGuests người</span>
                                </div>
                                <div class="item-detail">
                                    <span class="detail-label">Vị trí bàn</span>
                                    <span class="detail-value">@(reservation.Table?.Location ?? "N/A")</span>
                                </div>
                                <div class="item-detail">
                                    <span class="detail-label">Ngày đặt</span>
                                    <span class="detail-value">@reservation.CreatedAt.ToString("dd/MM/yyyy HH:mm")</span>
                                </div>
                            </div>

                            <!-- Notes Section -->
                            @if (!string.IsNullOrWhiteSpace(reservation.Notes))
                            {
                                <div class="item-note">
                                    <i class="bi bi-chat-left-text"></i>
                                    <span>@reservation.Notes</span>
                                </div>
                            }

                            <!-- Footer Section -->
                            <div class="item-footer-actions">
                                <a href="@Url.Action("Details", "Reservations", new { id = reservation.ReservationID })" class="btn-action btn-primary">
                                    <i class="bi bi-eye"></i> Xem chi tiết
                                </a>
                                @if (reservation.ReservationStatus.ToLower() == "pending" || reservation.ReservationStatus.ToLower() == "confirmed")
                                {
                                    <button class="btn-action" onclick="if(confirm('Bạn có chắc muốn hủy đặt bàn này?')) { window.location='@Url.Action("Cancel", "Reservations", new { id = reservation.ReservationID })'; }">
                                        <i class="bi bi-x-circle"></i> Hủy
                                    </button>
                                }
                            </div>
                        </article>
                    }
                </div>
            }
            else
            {
                <div class="empty-state">
                    <i class="bi bi-calendar-event"></i>
                    <h3>Chưa có đặt bàn nào</h3>
                    <p>Bạn chưa đặt bàn nào. Hãy tạo một đặt bàn mới!</p>
                    <a asp-area="Customer" asp-controller="Reservations" asp-action="Create">Đặt bàn ngay</a>
                </div>
            }
        </div>
    </main>


<script>
    // Tab switching
    document.querySelectorAll('.tab-item').forEach(tab => {
        tab.addEventListener('click', function (e) {
            e.preventDefault();
            const tabName = this.getAttribute('data-tab');

            // Remove active class from all tabs and contents
            document.querySelectorAll('.tab-item').forEach(t => t.classList.remove('active'));
            document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));

            // Add active class to clicked tab
            this.classList.add('active');

            // Show corresponding content
            document.getElementById(tabName + '-tab').classList.add('active');
        });
    });
</script>
