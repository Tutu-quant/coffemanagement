@model Quản_lý_quán_cafe.Models.Entities.Reservation

@section Head {
    <link rel="stylesheet" href="~/css/customers.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/reservation.css" asp-append-version="true" />
}

@{
    ViewData["Title"] = $"Đặt bàn #{Model.ReservationID}";
    ViewData["PageTitle"] = "Chi tiết đặt bàn";
    Layout = "_UnifiedLayout";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <div>
        <h1 class="h3 mb-1">Đặt bàn #@Model.ReservationID</h1>
        <span class="badge @StatusClass(Model.ReservationStatus)">@StatusText(Model.ReservationStatus)</span>
    </div>
    <a asp-action="History" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Quay lại</a>
</div>

<div class="row justify-content-center">
    <div class="col-xl-8">
        <div class="card">
            <div class="card-body p-4">
                <div class="row g-4">
                    <div class="col-md-6"><div class="text-muted small">Bàn</div><div class="fs-5 fw-semibold">@(Model.Table?.TableNumber ?? Model.TableID.ToString())</div></div>
                    <div class="col-md-6"><div class="text-muted small">Số khách</div><div class="fs-5 fw-semibold">@Model.NumberOfGuests người</div></div>
                    <div class="col-md-6"><div class="text-muted small">Ngày giờ đặt</div><div class="fs-5 fw-semibold">@Model.ReservationDate.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</div></div>
                    <div class="col-md-6"><div class="text-muted small">Vị trí</div><div class="fs-5 fw-semibold">@(Model.Table?.Location ?? "-")</div></div>
                    @if (!string.IsNullOrWhiteSpace(Model.Notes))
                    {
                        <div class="col-12"><div class="text-muted small">Ghi chú</div><div>@Model.Notes</div></div>
                    }
                </div>

                @if (Model.ReservationStatus is "Pending" or "Confirmed")
                {
                    <hr class="my-4" />
                    <form asp-action="Cancel" asp-route-id="@Model.ReservationID" method="post"
                          onsubmit="return confirm('Bạn chắc chắn muốn hủy lượt đặt bàn này?')">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-danger"><i class="bi bi-x-circle"></i> Hủy đặt bàn</button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

@functions {
    private static string StatusClass(string? status) => status switch
    {
        "Pending" => "bg-warning text-dark",
        "Confirmed" => "bg-success",
        "CheckedIn" => "bg-primary",
        "Completed" => "bg-info text-dark",
        "Cancelled" => "bg-danger",
        _ => "bg-secondary"
    };

    private static string StatusText(string? status) => status switch
    {
        "Pending" => "Chờ xác nhận",
        "Confirmed" => "Đã xác nhận",
        "CheckedIn" => "Đã nhận bàn",
        "Completed" => "Hoàn tất",
        "Cancelled" => "Đã hủy",
        _ => status ?? "Không xác định"
    };
}
