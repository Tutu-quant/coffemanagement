@model Quản_lý_quán_cafe.Models.Entities.Reservation

@{
    ViewData["Title"] = "Chi tiết đặt bàn";
    Layout = "_UnifiedLayout";
}

<div class="d-flex">
    <aside class="flex-shrink-0">
        @await Html.PartialAsync("_CustomerSidebar")
    </aside>

    <main class="flex-grow-1 px-4 py-3">
        <div class="page-header mb-4">
            <h4 class="m-0">Chi tiết đặt bàn</h4>
        </div>

        <div class="card">
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <p class="mb-1"><strong>Mã đặt:</strong> @Model.ReservationID</p>
                        <p class="mb-1"><strong>Bàn:</strong> @(Model.Table?.TableNumber ?? Model.TableID.ToString())</p>
                        <p class="mb-1"><strong>Thời gian:</strong> @Model.ReservationDate.ToLocalTime().ToString("f")</p>
                    </div>
                    <div class="col-md-6">
                        <p class="mb-1"><strong>Số khách:</strong> @Model.NumberOfGuests</p>
                        <p class="mb-1"><strong>Trạng thái:</strong> @Model.ReservationStatus</p>
                        <p class="mb-1"><strong>Ngày đặt:</strong> @Model.CreatedAt.ToLocalTime().ToString("g")</p>
                    </div>
                    <div class="col-12">
                        <p><strong>Ghi chú:</strong></p>
                        <div class="border rounded p-2">@Model.Notes ?? <span class="text-muted">—</span></div>
                    </div>
                </div>

                <div class="mt-3">
                    <a asp-area="Customer" asp-controller="Reservations" asp-action="History" class="btn btn-secondary">Quay lại</a>
                </div>
            </div>
        </div>
    </main>
</div>