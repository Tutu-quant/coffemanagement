@model IEnumerable<Quản_lý_quán_cafe.Models.Entities.RestaurantTable>

@section Head {
    <link rel="stylesheet" href="~/css/customers.css" asp-append-version="true" />
}

@{
    ViewData["Title"] = "Sơ đồ bàn";
    Layout = "_UnifiedLayout";
}

<div class="d-flex">
    <aside class="flex-shrink-0">
        @await Html.PartialAsync("_CustomerSidebar")
    </aside>

    <main class="flex-grow-1 px-4 py-3">
        <div class="page-header d-flex justify-content-between align-items-center mb-4">
            <h4 class="m-0">Sơ đồ bàn</h4>
            <a asp-area="Customer" asp-controller="Reservations" asp-action="History" class="btn btn-outline-secondary btn-sm">Lịch sử đặt bàn</a>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">@TempData["SuccessMessage"]</div>
        }

        <div class="row gy-3">
            @foreach (var t in Model)
            {
                var badgeClass = t.TableStatus switch
                {
                    "Available" => "badge-available",
                    "Occupied" => "badge-occupied",
                    "Maintenance" => "badge-maintenance",
                    _ => "badge-maintenance"
                };
                <div class="col-sm-6 col-md-4 col-lg-3">
                    <div class="card table-tile h-100 shadow-sm">
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <h6 class="tile-title mb-0">@t.TableNumber</h6>
                                    <small class="tile-meta">@t.Location</small>
                                </div>
                                <span class="badge @badgeClass">@t.TableStatus</span>
                            </div>

                            <p class="mb-3 small">
                                <strong>Sức chứa:</strong> @t.Capacity
                            </p>

                            <div class="mt-auto d-flex gap-2">
                                <a asp-area="Customer" asp-controller="Reservations" asp-action="Create" asp-route-tableId="@t.TableID" class="btn btn-primary btn-sm flex-fill">Đặt bàn</a>
                                <a asp-area="Customer" asp-controller="Orders" asp-action="Menu" asp-route-tableId="@t.TableID" class="btn btn-outline-primary btn-sm">Gọi món</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </main>
</div>
